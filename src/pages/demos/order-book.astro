---
import Demo from "../../layouts/Demo.astro";
import Icon from "../../components/Icon.astro";
const code = [
  { label: "This demo's source", href: "https://github.com/oscar-chw/oscar-chw.github.io" },
  { label: "The C++20 order-book replay (the point-in-time research platform)", href: "https://github.com/oscar-chw/agentic-quant-research/tree/main/platform" },
];
---
<Demo code={code} title="Order-book replay" description="A limit order book with price-time priority, replaying seeded order flow one event at a time. Resting quotes queue at their price; aggressive orders take liquidity from the best price first.">
  <Fragment slot="instructions">Press <strong>Play</strong> to run the tape, or <strong>Step</strong> to apply one event at a time. Change the seed for a different session. Bids are green and asks are red; the bar length is the size resting at each price.</Fragment>
  <div class="replay">
    <div class="panel">
      <div class="controls">
        <button type="button" data-testid="replay-play" aria-pressed="false"><Icon name="play" size={15} class="i-play" /><Icon name="pause" size={15} class="i-pause" /><span class="lbl">Play</span></button>
        <button type="button" data-testid="replay-stepbtn" title="Click to step once; hold to keep stepping"><Icon name="step-forward" size={15} />Step</button>
        <button type="button" id="replay-reset"><Icon name="rotate-ccw" size={15} />Reset book</button>
        <label>seed <input type="number" id="seed" value="7" min="1" max="9999" /></label>
        <label>speed <input type="range" id="speed" min="1" max="60" value="20" /></label>
      </div>
      <dl class="stats">
        <div><dt>event</dt><dd data-testid="replay-step">0</dd></div>
        <div><dt>best bid</dt><dd class="up" data-testid="best-bid">–</dd></div>
        <div><dt>best ask</dt><dd class="down" data-testid="best-ask">–</dd></div>
        <div><dt>trades</dt><dd id="ntrades">0</dd></div>
      </dl>
      <table class="ladder" aria-label="Order book, top 8 levels each side">
        <thead><tr><th scope="col">bid size</th><th scope="col">price</th><th scope="col">ask size</th></tr></thead>
        <tbody id="ladder"></tbody>
      </table>
      <section class="manual-entry">
        <h2>Place your own order</h2>
        <p class="comment">Orders run in this local matching engine. Submitting pauses the synthetic tape so you can inspect the result.</p>
        <form id="manual-order" novalidate>
          <label>Order kind<select id="manual-kind" aria-label="Order kind"><option value="limit">limit</option><option value="market">market</option></select></label>
          <label>Order side<select id="manual-side" aria-label="Order side"><option value="buy">buy</option><option value="sell">sell</option></select></label>
          <label>Order price (ticks)<input id="manual-price" type="number" value="10000" min="1" max="1000000" aria-label="Order price (ticks)" /></label>
          <label>Order quantity<input id="manual-qty" type="number" value="1" min="1" max="10000" aria-label="Order quantity" /></label>
          <button type="submit"><Icon name="send" size={15} />Submit local order</button>
        </form>
        <p class="manual-order-status" role="status">Use a limit price to rest or cross the book, or a market order to take available liquidity.</p>
        <ul class="manual-orders" aria-label="Your local orders"></ul>
      </section>
    </div>
    <div class="panel">
      <canvas id="mid" width="640" height="220" aria-label="Mid price over the last 400 events"></canvas>
      <p class="comment">mid price, last 400 events</p>
      <ol id="tape" class="tape" aria-label="Most recent events"></ol>
    </div>
  </div>
  <Fragment slot="source">
    <strong>Data: SYNTHETIC.</strong> A seeded random-walk fair value; passive quotes placed around it; cancels; and market orders that cross the spread. No market data is used. The matching engine is <code>src/lib/replay.ts</code>, which has unit tests checking that the book never ends a step crossed and that fills follow price-time priority.
  </Fragment>
</Demo>

<script>
  import { syntheticTape, LimitBook, type Event } from "../../lib/replay";
  import {manualOrder} from "../../lib/replay-input";
  import {h,button} from "../../components/lab/ui";

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const play = $("[data-testid=replay-play]"), stepBtn = $("[data-testid=replay-stepbtn]");
  const seedIn = $<HTMLInputElement>("#seed"), speed = $<HTMLInputElement>("#speed");
  const stepOut = $("[data-testid=replay-step]"), bidOut = $("[data-testid=best-bid]"), askOut = $("[data-testid=best-ask]");
  const ladder = $("#ladder"), tape = $("#tape"), ntrades = $("#ntrades");
  const canvas = $<HTMLCanvasElement>("#mid"), cx = canvas.getContext("2d")!;
  const N = 4000, WINDOW = 400;          // tape length; events shown in the mid-price chart

  let events: Event[] = [], book = new LimitBook(), i = 0, trades = 0, mids: number[] = [], timer = 0;
  let nextManual=1000000;
  const own:{event:Exclude<Event,{kind:'cancel'}>;cancelled:boolean;filled:number}[]=[];
  const ownList=$('.manual-orders'),ownStatus=$('.manual-order-status');
  const orderKind=$<HTMLSelectElement>('#manual-kind'),orderSide=$<HTMLSelectElement>('#manual-side'),orderPrice=$<HTMLInputElement>('#manual-price'),orderQty=$<HTMLInputElement>('#manual-qty');
  const remaining=(id:number)=>[...book.bids.values(),...book.asks.values()].flat().find(o=>o.id===id)?.qty??0;
  function renderOwn(){
    ownList.replaceChildren(...own.map(o=>{
      const rest=remaining(o.event.id),cancel=button(`Cancel order ${o.event.id}`,()=>{stop();book.apply({kind:'cancel',id:o.event.id,t:i});o.cancelled=true;render();});
      cancel.disabled=o.cancelled||rest===0;
      return h('li',{},h('span',{},`#${o.event.id} ${o.event.side} ${o.event.qty}${o.event.kind==='limit'?` @ ${o.event.price}`:''} · ${o.cancelled?'cancelled':o.event.kind==='limit'?`resting ${rest}`:`filled ${o.filled}; unfilled ${o.event.qty-o.filled} discarded`}`),cancel);
    }));
  }

  function reset() {
    events = syntheticTape(Number(seedIn.value) || 7, N); book = new LimitBook(); i = 0; trades = 0; mids = [];
    own.length=0;nextManual=1000000;
    for (let w = 0; w < 120; w++) apply(false);          // warm-up so the book starts populated
    render();
  }
  function apply(log = true) {
    if (i >= events.length) { stop(); return; }
    const ev = events[i++], fills = book.apply(ev);
    trades += fills.length;
    const { bid, ask } = book.best();
    if (bid !== null && ask !== null) mids.push((bid + ask) / 2);
    if (log) {
      const li = document.createElement("li");
      li.textContent = ev.kind === "cancel" ? `cancel #${ev.id}` : ev.kind === "limit" ? `${ev.side} ${ev.qty} @ ${ev.price}` : `market ${ev.side} ${ev.qty}` + (fills.length ? ` → ${fills.map((f) => `${f.qty}@${f.price}`).join(", ")}` : "");
      if (fills.length) li.className = fills[0].side === "buy" ? "up" : "down";
      tape.prepend(li);
      while (tape.children.length > 12) tape.lastElementChild!.remove();
    }
  }
  function render() {
    stepOut.textContent = String(i);
    const { bid, ask } = book.best();
    bidOut.textContent = bid === null ? "–" : String(bid);
    askOut.textContent = ask === null ? "–" : String(ask);
    ntrades.textContent = String(trades);
    renderOwn();
    const d = book.depth(8), max = Math.max(1, ...d.bids.map((l) => l[1]), ...d.asks.map((l) => l[1]));
    const row = (b: [number, number] | null, a: [number, number] | null, p: number) =>
      `<tr><td>${b ? `<span class="bar b" style="width:${(b[1] / max) * 100}%"></span>${b[1]}` : ""}</td><td class="p">${p}</td><td>${a ? `<span class="bar a" style="width:${(a[1] / max) * 100}%"></span>${a[1]}` : ""}</td></tr>`;
    ladder.innerHTML = [...d.asks].reverse().map((a) => row(null, a, a[0])).join("") + d.bids.map((b) => row(b, null, b[0])).join("");
    // mid-price sparkline
    cx.clearRect(0, 0, canvas.width, canvas.height);
    const recent = mids.slice(-WINDOW);
    if (recent.length > 1) {
      const lo = Math.min(...recent), hi = Math.max(...recent), W = canvas.width, H = canvas.height;
      cx.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue("--accent"); cx.lineWidth = 1.5; cx.beginPath();
      recent.forEach((m, j) => { const x = (j / (WINDOW - 1)) * W, y = H - 10 - ((m - lo) / Math.max(hi - lo, 1)) * (H - 20); j ? cx.lineTo(x, y) : cx.moveTo(x, y); });
      cx.stroke();
    }
  }
  function tick() { for (let s = 0; s < Number(speed.value) / 10 + 1; s++) apply(); render(); }
  const playLabel = play.querySelector(".lbl")!;
  function stop() { clearInterval(timer); timer = 0; playLabel.textContent = "Play"; play.setAttribute("aria-pressed", "false"); }
  play.addEventListener("click", () => {
    if (timer) { stop(); return; }
    timer = window.setInterval(tick, 100);
    playLabel.textContent = "Pause"; play.setAttribute("aria-pressed", "true");
  });
  // Step: one event per click; hold it (pointer, or Enter/Space) and it keeps stepping, faster the longer you hold
  let holdTimer = 0, holdDelay = 0, held = false;
  const stepOnce = () => { apply(); render(); };
  const repeat = () => { stepOnce(); holdDelay = Math.max(16, holdDelay * 0.85); holdTimer = window.setTimeout(repeat, holdDelay); };
  const release = () => { clearTimeout(holdTimer); holdTimer = 0; };
  stepBtn.addEventListener("pointerdown", (e) => {
    if (e.button !== 0) return;
    stop(); held = true; stepOnce();
    holdDelay = 120; holdTimer = window.setTimeout(repeat, 380);
    stepBtn.setPointerCapture(e.pointerId);
  });
  for (const ev of ["pointerup", "pointercancel", "lostpointercapture"]) stepBtn.addEventListener(ev, release);
  stepBtn.addEventListener("click", (e) => { if (held) { held = false; return; } e.preventDefault(); stop(); stepOnce(); });   // keyboard click
  stepBtn.addEventListener("keydown", (e) => { if ((e.key === "Enter" || e.key === " ") && e.repeat) { e.preventDefault(); stepOnce(); } });
  seedIn.addEventListener("change", () => {
    const seed=Number(seedIn.value);
    if(!seedIn.value.trim()||!Number.isInteger(seed)||seed<1||seed>9999){ownStatus.textContent='Seed must be an integer from 1 to 9999; the current book was not replaced.';return;}
    stop();tape.replaceChildren();reset();
  });
  $('#replay-reset').addEventListener('click',()=>{stop();seedIn.value='7';tape.replaceChildren();ownStatus.textContent='Book reset; your local orders were cleared.';reset();});
  orderKind.addEventListener('change',()=>{orderPrice.disabled=orderKind.value==='market';});
  $('#manual-order').addEventListener('submit',event=>{
    event.preventDefault();
    try{
      if(own.length>=128)throw new Error('Reset the book before adding more than 128 local orders.');
      const ev=manualOrder(orderKind.value,orderSide.value,orderPrice.value,orderQty.value,nextManual,i);
      stop();nextManual++;const fills=book.apply(ev);trades+=fills.length;
      own.push({event:ev,cancelled:false,filled:fills.reduce((sum,f)=>sum+f.qty,0)});
      ownStatus.textContent=`Order ${ev.id}: ${fills.length?fills.map(f=>`${f.qty} filled at ${f.price} against maker ${f.maker}`).join('; '):'no immediate fill'}. ${ev.kind==='limit'?`${remaining(ev.id)} resting.`:'Unfilled market quantity does not rest.'}`;
      tape.prepend(h('li',{},`local #${ev.id} ${ev.side} ${ev.qty}${ev.kind==='limit'?` @ ${ev.price}`:''}`));while(tape.children.length>12)tape.lastElementChild!.remove();render();
    }catch(error){ownStatus.textContent=error instanceof Error?error.message:String(error);}
  });
  document.addEventListener("themechange", render);
  reset();
</script>

<style>
  .replay { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; }
  .panel { min-width: 0; }
  .controls { display: flex; flex-wrap: wrap; gap: 10px 16px; align-items: center; margin-bottom: 12px; }
  .controls label { display: flex; gap: 8px; align-items: center; color: var(--muted); font-size: 0.9rem; }
  input[type=number] { width: 5.5em; font: inherit; background: var(--bg-2); color: var(--ink); border: 1px solid var(--line); border-radius: 4px; padding: 3px 6px; }
  input[type=range] { accent-color: var(--accent); }
  button { font: inherit; font-size: 0.95rem; background: var(--bg-2); color: var(--ink); border: 1px solid var(--line); padding: 7px 14px; border-radius: 6px; cursor: pointer; }
  button[aria-pressed=true] { border-color: var(--accent); }
  button { display: inline-flex; align-items: center; gap: 7px; }
  button[aria-pressed="false"] :global(.i-pause), button[aria-pressed="true"] :global(.i-play) { display: none; }
  .stats { display: flex; flex-wrap: wrap; gap: 6px 26px; margin: 0 0 12px; }
  .stats div { display: flex; gap: 8px; align-items: baseline; }
  .stats dt { font: 0.8rem ui-monospace, Menlo, monospace; color: var(--muted); }
  .stats dd { margin: 0; font: 600 1rem ui-monospace, Menlo, monospace; }
  .ladder { width: 100%; border-collapse: collapse; font: 0.88rem ui-monospace, Menlo, monospace; table-layout: fixed; }
  .ladder th { color: var(--muted); font-weight: 400; font-size: 0.78rem; text-align: center; padding-bottom: 4px; }
  .ladder :global(td) { position: relative; padding: 3px 8px; text-align: center; border-top: 1px solid var(--line); }
  .ladder :global(td.p) { color: var(--ink); }
  .ladder :global(.bar) { position: absolute; top: 3px; bottom: 3px; opacity: 0.28; z-index: -1; }
  .ladder :global(.bar.b) { right: 0; background: var(--up); }
  .ladder :global(.bar.a) { left: 0; background: var(--down); }
  .ladder :global(tbody) { position: relative; z-index: 0; }
  canvas { width: 100%; height: auto; background: var(--bg-2); border-radius: 8px; }
  .tape { list-style: none; padding: 0; margin: 10px 0 0; font: 0.85rem ui-monospace, Menlo, monospace; color: var(--muted); min-height: 14em; }
  .tape :global(li.up) { color: var(--up); } .tape :global(li.down) { color: var(--down); }
  .manual-entry { margin-top:24px; border-top:1px solid var(--line); padding-top:18px; }
  #manual-order { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
  #manual-order label { display:grid; gap:6px; min-width:0; font-size:0.9rem; }
  #manual-order input,#manual-order select { width:100%; min-width:0; box-sizing:border-box; min-height:44px; font:inherit; color:var(--ink); background:var(--bg-2); border:1px solid var(--line); border-radius:8px; padding:8px; }
  #manual-order button { grid-column:1/-1; min-height:44px; }
  .manual-orders { list-style:none; padding:0; display:grid; gap:10px; font-size:0.9rem; }
  .manual-orders :global(li) { display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:space-between; overflow-wrap:anywhere; }
  .manual-order-status { font-size:0.9rem; line-height:1.7; }
  @media (max-width: 760px) { .replay { grid-template-columns: 1fr; } }
</style>
