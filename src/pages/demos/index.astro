---
// The Lab: one workspace. A file-tree rail of experiments (one or more per project), a stage
// where the chosen experiment runs in place, and its instrument panel. Experiments load on
// demand; without JS the page is a readable index linking each project and full demo.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { EXPERIMENTS } from "../../data/lab";
import { url } from "../../lib/url";
import "../../styles/lab.css";

const folders = [...new Set(EXPERIMENTS.map((e) => e.folder))];
---
<Base title="The Lab" description="Interactive experiments, one for every project, running in your browser.">
  <div class="wrap labhead">
    <p class="comment">runs in your browser · no server · no tracking · every experiment says where its data comes from</p>
    <h1>The Lab</h1>
  </div>
  <div class="wrap lab" data-lab data-base={import.meta.env.BASE_URL}>
    <nav class="tree mono" aria-label="Experiments">
      <p class="root">~/lab</p>
      <div role="listbox" aria-label="Experiments" tabindex="0">
        {folders.map((f) => (
          <div class="dir" role="group" aria-labelledby={`dir-${f}`}><span class="d" id={`dir-${f}`} data-dir><Icon name="folder" size={14} />{f}/<span class="chev" aria-hidden="true">▾</span></span>
            <div class="files">
              {EXPERIMENTS.filter((e) => e.folder === f).map((e) => (
                <div role="option" id={`opt-${e.id}`} data-exp={e.id} aria-selected="false">
                  <a href={e.kind === "page" ? url(e.href!) : `#${e.id}`}><Icon name={e.kind === "page" ? "external-link" : "file-code"} size={13} />{e.file}</a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </nav>

    <section class="bench" aria-live="polite">
      {EXPERIMENTS.map((e, i) => (
        <article class="exp" data-panel={e.id} data-kind={e.kind} hidden={i !== 0}>
          <header class="eh">
            <p class="path mono">~/lab/{e.folder}/<b>{e.file}</b></p>
            <h2>{e.title}</h2>
            <p class="blurb">{e.blurb}</p>
            <p class="meta mono">
              <span class="data"><Icon name="database" size={13} />{e.data}</span>
              {e.project && <a href={url(`/projects/${e.project.split("#")[0]}/`) + (e.project.includes("#") ? `#${e.project.split("#")[1]}` : "")}><Icon name="arrow-up-right" size={13} />the project</a>}
              <a href={e.code}><Icon name="github" size={13} />code</a>
            </p>
          </header>
          {e.kind === "inline" ? (
            <div class="rig">
              <div class="stage glass hud" data-stage data-hud={`${String(i + 1).padStart(2, "0")} / ${EXPERIMENTS.length} · ${e.file}`}><p class="loading mono">loading experiment…</p></div>
              <div class="panel" data-controls></div>
            </div>
          ) : (
            <a class="launch glass" href={url(e.href!)}>
              <span class="mono">open the full experiment</span>
              <span class="lt">{e.title} <Icon name="arrow-right" size={28} /></span>
            </a>
          )}
        </article>
      ))}
    </section>
  </div>
</Base>

<script>
  const LOAD: Record<string, () => Promise<{ mount: (s: HTMLElement, c: HTMLElement) => void }>> = {
    gatedbuild: () => import("../../components/lab/exp/gatedbuild"),
    search: () => import("../../components/lab/exp/search"),
    lostupdates: () => import("../../components/lab/exp/lostupdates"),
    options: () => import("../../components/lab/exp/options"),
    dna: () => import("../../components/lab/exp/dna"),
    candles: () => import("../../components/lab/exp/candles"),
    guard: () => import("../../components/lab/exp/guard"),
    qubits: () => import("../../components/lab/exp/qubits"),
    asof: () => import("../../components/lab/exp/asof"),
    lookahead: () => import("../../components/lab/exp/lookahead"),
    marketmaking: () => import("../../components/lab/exp/marketmaking"),
    imc: () => import("../../components/lab/exp/marketmaking"),
    factors: () => import("../../components/lab/exp/factors"),
    multitest: () => import("../../components/lab/exp/multitest"),
    policy: () => import("../../components/lab/exp/policy"),
    timetable: () => import("../../components/lab/exp/timetable"),
    gate: () => import("../../components/lab/exp/gate"),
  };
  const lab = document.querySelector<HTMLElement>("[data-lab]")!;
  const opts = [...lab.querySelectorAll<HTMLElement>("[data-exp]")];
  const panels = new Map([...lab.querySelectorAll<HTMLElement>("[data-panel]")].map((p) => [p.dataset.panel!, p]));
  const mounted = new Set<string>();
  const list = lab.querySelector<HTMLElement>("[role=listbox]")!;
  lab.classList.add("live");

  async function open(id: string, push = true) {
    if (!panels.has(id)) return;
    for (const [k, p] of panels) p.hidden = k !== id;
    opts.forEach((o) => o.setAttribute("aria-selected", String(o.dataset.exp === id)));
    opts.find((o) => o.dataset.exp === id)?.closest(".dir")?.classList.remove("shut");   // the open file's folder is always open
    list.setAttribute("aria-activedescendant", `opt-${id}`);
    const panel = panels.get(id)!;
    panel.classList.remove("enter"); void panel.offsetWidth; panel.classList.add("enter");
    if (push) history.replaceState(null, "", `#${id}`);
    if (LOAD[id] && !mounted.has(id)) {
      mounted.add(id);
      const stage = panel.querySelector<HTMLElement>("[data-stage]")!, controls = panel.querySelector<HTMLElement>("[data-controls]")!;
      const m = await LOAD[id]();
      stage.replaceChildren(); m.mount(stage, controls);
    }
  }
  // every rail entry opens in the bench; full-page demos show a launch panel there
  // on a phone the bench sits below the file tree: bring the chosen experiment into view
  const narrow = matchMedia("(max-width: 800px)");
  for (const o of opts) o.querySelector("a")!.addEventListener("click", (e) => {
    e.preventDefault(); open(o.dataset.exp!);
    if (narrow.matches) panels.get(o.dataset.exp!)?.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth", block: "start" });
  });
  list.addEventListener("keydown", (e) => {
    const cur = opts.findIndex((o) => o.getAttribute("aria-selected") === "true");
    if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); open(opts[(cur + (e.key === "ArrowDown" ? 1 : opts.length - 1)) % opts.length].dataset.exp!); }
  });
  // a deep link opens its experiment; otherwise the first one in the list, the one the page shows without JS
  open(location.hash.slice(1) && panels.has(location.hash.slice(1)) ? location.hash.slice(1) : opts[0].dataset.exp!, false);
  // folders: click to fold; if the list is taller than its box, fold every folder but the open file's
  const tree = lab.querySelector<HTMLElement>(".tree")!, dirs = [...lab.querySelectorAll<HTMLElement>(".tree .dir")];
  for (const d of dirs) d.querySelector("[data-dir]")!.addEventListener("click", () => d.classList.toggle("shut"));
  const fit = () => {
    dirs.forEach((d) => d.classList.remove("shut"));
    const box = narrow.matches ? list : tree;
    // fold the biggest folders first, one at a time, only until the list fits (never the open file's)
    const order = dirs.filter((d) => !d.querySelector('[aria-selected="true"]')).sort((x, y) => y.querySelectorAll("[role=option]").length - x.querySelectorAll("[role=option]").length);
    for (const d of order) { if (box.scrollHeight <= box.clientHeight + 4) break; d.classList.add("shut"); }
  };
  fit(); addEventListener("resize", fit);
</script>
