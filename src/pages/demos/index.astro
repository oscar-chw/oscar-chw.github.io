---
// The Lab: one workspace. A file-tree rail of experiments (one or more per project), a stage
// where the chosen experiment runs in place, and its instrument panel. Experiments load on
// demand; without JS the page is a readable index linking each project and full demo.
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { EXPERIMENTS } from "../../data/lab";
import { url } from "../../lib/url";
import "../../styles/lab.css";
import "../../styles/lab-navigation.css";

const folders = [...new Set(EXPERIMENTS.map((e) => e.folder))];
---
<Base title="The Lab" description="Interactive experiments, one for every project, running in your browser.">
  <div class="wrap labhead">
    <p class="comment">runs in your browser · no server · no tracking · every experiment says where its data comes from</p>
    <h1>The Lab</h1>
  </div>
  <div class="wrap lab" data-lab data-base={import.meta.env.BASE_URL}>
    <nav class="tree mono" aria-label="Experiments" data-lenis-prevent>
      <div class="root rail-selection" role="listbox" aria-label="Experiments" aria-owns={folders.map((_, i) => `lab-files-${i}`).join(" ")} tabindex="0">~/lab <span aria-hidden="true">↑↓ browse</span></div>
      <div class="rail-files" data-lenis-prevent>
        {folders.map((f, i) => (
          <div class="dir"><button class="d" id={`dir-${f}`} data-dir type="button" aria-controls={`lab-files-${i}`} aria-expanded="true"><Icon name="folder" size={14} />{f}/<span class="chev" aria-hidden="true">▾</span></button>
            <div class="files" id={`lab-files-${i}`} role="group" aria-labelledby={`dir-${f}`}>
              {EXPERIMENTS.filter((e) => e.folder === f).map((e) => (
                <div role="option" id={`opt-${e.id}`} data-exp={e.id} aria-selected="false">
                  <a href={e.kind === "page" ? url(e.href!) : `#${e.id}`}><Icon name={e.kind === "page" ? "external-link" : "file-code"} size={13} />{e.file}</a>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </nav>

    <section class="bench" aria-live="polite">
      {EXPERIMENTS.map((e, i) => (
        <article class="exp" data-panel={e.id} data-kind={e.kind} hidden={i !== 0}>
          <header class="eh">
            <p class="path mono">~/lab/{e.folder}/<b>{e.file}</b></p>
            <h2>{e.title}</h2>
            <p class="blurb">{e.blurb}</p>
            <p class="meta mono">
              <span class="data"><Icon name="database" size={13} />{e.data}</span>
              {e.project && <a href={url(`/projects/${e.project.split("#")[0]}/`) + (e.project.includes("#") ? `#${e.project.split("#")[1]}` : "")}><Icon name="arrow-up-right" size={13} />the project</a>}
              <a href={e.code}><Icon name="github" size={13} />code</a>
            </p>
          </header>
          {e.kind === "inline" ? (
            <div class="rig">
              <div class="stage glass hud" data-stage data-load-state="loading" aria-busy="true" data-hud={`${String(i + 1).padStart(2, "0")} / ${EXPERIMENTS.length} · ${e.file}`}><p class="loading mono" role="status">loading experiment…</p></div>
              <div class="panel" data-controls></div>
            </div>
          ) : (
            <a class="launch glass" href={url(e.href!)}>
              <span class="mono">open the full experiment</span>
              <span class="lt">{e.title} <Icon name="arrow-right" size={28} /></span>
            </a>
          )}
        </article>
      ))}
    </section>
  </div>
</Base>

<script>
  import { mountExperiment, LOAD } from "../../components/lab/registry";
  const lab = document.querySelector<HTMLElement>("[data-lab]")!;
  const opts = [...lab.querySelectorAll<HTMLElement>("[data-exp]")];
  const panels = new Map([...lab.querySelectorAll<HTMLElement>("[data-panel]")].map((p) => [p.dataset.panel!, p]));
  const mounted = new Set<string>();
  const rail = lab.querySelector<HTMLElement>(".rail-files")!;
  // The visible keyboard selector owns the option groups. Disclosure buttons stay
  // siblings, outside that selection widget, with their native button semantics.
  const list = lab.querySelector<HTMLElement>(".tree [role=listbox]")!;
  const tree = lab.querySelector<HTMLElement>(".tree")!;
  lab.classList.add("live");

  async function open(id: string, push = true) {
    if (!panels.has(id)) return;
    for (const [k, p] of panels) p.hidden = k !== id;
    opts.forEach((o) => o.setAttribute("aria-selected", String(o.dataset.exp === id)));
    const folder = opts.find((o) => o.dataset.exp === id)?.closest<HTMLElement>(".dir");
    folder?.classList.remove("shut"); // the open file's folder is always open
    folder?.querySelector("[data-dir]")?.setAttribute("aria-expanded", "true");
    list.setAttribute("aria-activedescendant", `opt-${id}`);
    const panel = panels.get(id)!;
    panel.classList.remove("enter"); void panel.offsetWidth; panel.classList.add("enter");
    if (push) history.replaceState(null, "", `#${id}`);
    if (LOAD[id] && !mounted.has(id)) {
      mounted.add(id);
      const stage = panel.querySelector<HTMLElement>("[data-stage]")!, controls = panel.querySelector<HTMLElement>("[data-controls]")!;
      await mountExperiment(id, stage, controls);
    }
  }
  // every rail entry opens in the bench; full-page demos show a launch panel there
  // on a phone the bench sits below the file tree: bring the chosen experiment into view
  const narrow = matchMedia("(max-width: 800px)");
  const reveal = (id: string, smooth = false) => {
    if (narrow.matches) panels.get(id)?.scrollIntoView({ behavior: smooth && !matchMedia("(prefers-reduced-motion: reduce)").matches ? "smooth" : "instant", block: "start" });
  };
  const revealRailEntry = (id: string) => opts.find((o) => o.dataset.exp === id)?.querySelector("a")?.scrollIntoView({ block: "nearest" });
  for (const o of opts) o.querySelector("a")!.addEventListener("click", (e) => {
    if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault(); open(o.dataset.exp!);
    reveal(o.dataset.exp!, true);
  });
  tree.addEventListener("keydown", (e) => {
    if ((e.target as Element).closest("button[data-dir]")) return;
    const cur = opts.findIndex((o) => o.getAttribute("aria-selected") === "true");
    if (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Home" || e.key === "End") {
      e.preventDefault();
      const next = e.key === "Home" ? 0 : e.key === "End" ? opts.length - 1 : (cur + (e.key === "ArrowDown" ? 1 : opts.length - 1)) % opts.length;
      const id = opts[next].dataset.exp!;
      open(id);
      list.focus({ preventScroll: true });
      revealRailEntry(id);
    } else if (e.key === "Enter" && document.activeElement === list) {
      e.preventDefault();
      const id = opts.find((o) => o.getAttribute("aria-selected") === "true")?.dataset.exp;
      if (id) open(id);
    }
  });
  // a deep link opens its experiment; otherwise the first one in the list, the one the page shows without JS
  open(location.hash.slice(1) && panels.has(location.hash.slice(1)) ? location.hash.slice(1) : opts[0].dataset.exp!, false);
  // a link to another experiment from this page (the command menu, search, a typed hash) changes only the hash: open it too
  addEventListener("hashchange", () => { const id = location.hash.slice(1); if (panels.has(id)) { open(id, false); reveal(id); } });
  // folders: click to fold; if the list is taller than its box, fold every folder but the open file's
  const dirs = [...lab.querySelectorAll<HTMLElement>(".tree .dir")];
  for (const d of dirs) d.querySelector<HTMLButtonElement>("[data-dir]")!.addEventListener("click", (e) => {
    const expanded = (e.currentTarget as HTMLButtonElement).getAttribute("aria-expanded") === "true";
    d.classList.toggle("shut", expanded);
    (e.currentTarget as HTMLButtonElement).setAttribute("aria-expanded", String(!expanded));
  });
  const fit = () => {
    dirs.forEach((d) => { d.classList.remove("shut"); d.querySelector("[data-dir]")?.setAttribute("aria-expanded", "true"); });
    const box = narrow.matches ? rail : tree;
    // fold the biggest folders first, one at a time, only until the list fits (never the open file's)
    const order = dirs.filter((d) => !d.querySelector('[aria-selected="true"]')).sort((x, y) => y.querySelectorAll("[role=option]").length - x.querySelectorAll("[role=option]").length);
    for (const d of order) { if (box.scrollHeight <= box.clientHeight + 4) break; d.classList.add("shut"); d.querySelector("[data-dir]")?.setAttribute("aria-expanded", "false"); }
  };
  fit(); addEventListener("resize", fit);
  if (panels.has(location.hash.slice(1))) reveal(location.hash.slice(1));
</script>
