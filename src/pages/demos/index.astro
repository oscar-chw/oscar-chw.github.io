---
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/url";
const demos = [
  ["/demos/fourier/", "Fourier portrait", "Up to 500 rotating circles redraw a line portrait. Change the number of circles, or draw your own shape and watch it get redrawn.", "photo → one closed path"],
  ["/demos/order-book/", "Order-book replay", "A price-time-priority matching engine replays seeded order flow step by step: quotes, cancels and trades.", "SYNTHETIC order flow"],
  ["/demos/reconciliation/", "Streaming reconciliation", "Peak memory for an in-memory reader and a streaming reader of the same 225,000 rows, with each reader's memory over time.", "SYNTHETIC benchmark, measured"],
  ["/demos/harbour/", "The harbour", "The home-page harbour, full size: BTC history as a skyline, a platform race test as beams, and the live order book as the water.", "Binance public data"],
] as const;
---
<Base title="Demos" description="Interactive demos by Oscar Choi. All run in your browser.">
  <div class="wrap">
    <header class="cols top">
      <p class="comment kick">runs in your browser · no server · no tracking</p>
      <h1>Demos</h1>
      <p class="lede">Each one says where its data comes from.</p>
    </header>
    <ul class="tiles">
      {demos.map(([href, t, d, src], i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a class="tile glass" href={url(href)}>
            <span class="num mono">0{i + 1}</span>
            <span class="tt">{t}</span>
            <span class="td">{d}</span>
            <span class="src mono">{src}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .top { padding-top: 64px; margin-bottom: 40px; }
  .kick { grid-column: 1 / -1; margin: 0 0 12px; }
  h1 { grid-column: 1 / -1; font-size: clamp(3rem, 1.4rem + 7vw, 8rem); letter-spacing: -0.055em; margin: 0 0 18px; }
  .lede { grid-column: 1 / span 7; color: var(--muted); font-size: 1.12rem; margin: 0; }
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .tile { display: flex; flex-direction: column; gap: 10px; min-height: 240px; height: 100%; padding: 26px; border-radius: 22px; color: var(--ink); text-decoration: none; transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.2s; }
  .tile:hover { transform: translateY(-4px); border-color: var(--accent); }
  .num { color: var(--accent); }
  .tt { font-size: 1.6rem; font-weight: 600; letter-spacing: -0.025em; margin-top: auto; }
  .td { color: var(--muted); line-height: 1.55; }
  .src { color: var(--amber); font-size: 0.78rem; }
  @media (max-width: 760px) { .tiles { grid-template-columns: 1fr; } .lede { grid-column: 1 / -1; } }
</style>
