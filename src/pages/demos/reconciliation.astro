---
import Demo from "../../layouts/Demo.astro";
import Icon from "../../components/Icon.astro";
import { url } from "../../lib/url";
import r from "../../data/reconciliation.json";

// Chart geometry: time on x (seconds), resident memory on y (MB).
const W = 720, H = 300, L = 56, B = 34, T = 14, R = 16;
const tMax = 3.5, mMax = 700;
const x = (s: number) => L + (s / tMax) * (W - L - R);
const y = (mb: number) => H - B - (mb / mMax) * (H - B - T);
const xt = [0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5], yt = [0, 100, 200, 300, 400, 500, 600, 700];
const fmt = (n: number) => n.toLocaleString("en-US");
const code = [
  { label: "streaming-reconciliation (code and measurements)", href: "https://github.com/oscar-chw/streaming-reconciliation" },
  { label: "This demo's source", href: "https://github.com/oscar-chw/oscar-chw.github.io" },
];
---
<Demo code={code} title="Streaming reconciliation" description={`Two readers count the same ${fmt(r.rows)} trade rows exactly once. The in-memory reader holds the whole history; the streaming reader spills size-capped sorted runs to disk and merges them.`}>
  <Fragment slot="instructions">Press <strong>Run both</strong> to replay the two readers side by side on their measured run times. The table below the chart gives the measured peaks at two input sizes.</Fragment>

  <figure class="chart">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="chart-t chart-d">
      <title id="chart-t">Resident memory over time for two readers</title>
      <desc id="chart-d">In memory: grows to {r.baseline.peakMB} MB over {r.baseline.seconds} s. Streaming: stays at or under {r.streaming.peakMB} MB and finishes in {r.streaming.seconds} s.</desc>
      <defs><clipPath id="reveal"><rect id="reveal-rect" x="0" y="0" width={W} height={H} /></clipPath></defs>
      {yt.map((v) => <g><line x1={L} x2={W - R} y1={y(v)} y2={y(v)} class="grid" /><text x={L - 8} y={y(v) + 4} class="tick" text-anchor="end">{v}</text></g>)}
      {xt.map((v) => <text x={x(v)} y={H - B + 18} class="tick" text-anchor="middle">{v}</text>)}
      <text x={L} y={H - 2} class="axis">seconds</text>
      <text x="4" y={T + 4} class="axis">MB</text>
      <g clip-path="url(#reveal)">
        <g data-testid="series-inmemory">
          <line class="mem" x1={x(0)} y1={y(0)} x2={x(r.baseline.seconds)} y2={y(r.baseline.peakMB)} />
          <circle class="mem-dot" cx={x(r.baseline.seconds)} cy={y(r.baseline.peakMB)} r="4" />
        </g>
        <g data-testid="series-streaming">
          <line class="str" x1={x(0)} y1={y(r.streaming.peakMB)} x2={x(r.streaming.seconds)} y2={y(r.streaming.peakMB)} />
          <circle class="str-dot" cx={x(r.streaming.seconds)} cy={y(r.streaming.peakMB)} r="4" />
        </g>
      </g>
      <text x={x(r.baseline.seconds) - 8} y={y(r.baseline.peakMB) - 10} class="lab mem-t" text-anchor="end">in memory · {r.baseline.peakMB} MB peak · {r.baseline.seconds} s</text>
      <text x={x(r.streaming.seconds)} y={y(r.streaming.peakMB) - 12} class="lab str-t" text-anchor="end">streaming · {r.streaming.peakMB} MB peak · {r.streaming.seconds} s</text>
      <line id="cursor" x1={L} x2={L} y1={T} y2={H - B} class="cursor" />
    </svg>
    <figcaption class="comment">endpoints are measured; the in-memory line assumes memory grows with rows read, the streaming line that it is capped by the run size</figcaption>
  </figure>
  <p><button type="button" data-testid="recon-play"><Icon name="play" size={15} />Run both</button> <span class="mono" data-testid="recon-progress" data-value="0" aria-live="off">t = 0.00 s</span></p>

  <table class="peaks">
    <caption class="comment">measured peak memory (median of runs)</caption>
    <thead><tr><th scope="col">rows read</th><th scope="col">in memory</th><th scope="col">streaming</th></tr></thead>
    <tbody>{r.scale.map((s) => <tr><td>{fmt(s.rows)}</td><td>{s.baseline} MB</td><td>{s.streaming} MB</td></tr>)}</tbody>
  </table>
  <p class="measure">The in-memory reader grows with the history; the streaming reader stays flat. Its cost moves to disk instead: at most {r.streaming.tempMB} MB of temporary runs, deleted when the merge finishes. More in the <a href={url("/projects/streaming-reconciliation/")}>project write-up</a>.</p>

  <Fragment slot="source">
    <strong>Data: SYNTHETIC benchmark, real measurements.</strong> Peak memory and median times come from <code>results/resource-gate-2026-10-05.json</code> (seven alternating pairs, 225,000 rows) and <code>results/measure-2026-10-05.json</code> in <a href="https://github.com/oscar-chw/streaming-reconciliation">streaming-reconciliation</a>. The repository records peaks, not memory traces, so the shape between the endpoints is a model, labelled as such.
  </Fragment>
</Demo>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-testid=recon-play]")!;
  const prog = document.querySelector<HTMLElement>("[data-testid=recon-progress]")!;
  const rect = document.getElementById("reveal-rect")!, cursor = document.getElementById("cursor")!;
  const W = 720, L = 56, R = 16, tMax = 3.5, DURATION = 3500;   // replays at real time
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let raf = 0;
  function set(p: number) {
    const px = L + p * (W - L - R);
    rect.setAttribute("width", String(px));
    cursor.setAttribute("x1", String(px)); cursor.setAttribute("x2", String(px));
    prog.dataset.value = p.toFixed(3);
    prog.textContent = `t = ${(p * tMax).toFixed(2)} s`;
  }
  btn.addEventListener("click", () => {
    cancelAnimationFrame(raf);
    if (reduce) { set(1); return; }
    const t0 = performance.now();
    const step = (now: number) => { const p = Math.min(1, (now - t0) / DURATION); set(p); if (p < 1) raf = requestAnimationFrame(step); };
    raf = requestAnimationFrame(step);
  });
</script>

<style>
  .chart { margin: 0 0 1rem; max-width: 760px; }
  svg { width: 100%; height: auto; display: block; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .tick, .axis { fill: var(--muted); font: 11px ui-monospace, Menlo, monospace; }
  .mem { stroke: var(--down); stroke-width: 3; }
  .str { stroke: var(--accent); stroke-width: 3; }
  .mem-dot { fill: var(--down); } .str-dot { fill: var(--accent); }
  .lab { font: 12px ui-monospace, Menlo, monospace; }
  .mem-t { fill: var(--down); } .str-t { fill: var(--accent); }
  .cursor { stroke: var(--ink); stroke-dasharray: 3 4; opacity: 0.6; }
  button { display: inline-flex; align-items: center; gap: 7px; font: inherit; background: var(--bg-2); color: var(--ink); border: 1px solid var(--line); padding: 7px 14px; border-radius: 6px; cursor: pointer; }
  button:hover { border-color: var(--accent); }
  .peaks { border-collapse: collapse; margin: 1.4rem 0 1rem; font-variant-numeric: tabular-nums; }
  .peaks caption { text-align: left; margin-bottom: 6px; }
  .peaks th, .peaks td { border-top: 1px solid var(--line); padding: 7px 28px 7px 0; text-align: left; }
  .peaks th { color: var(--muted); font-weight: 400; }
</style>
