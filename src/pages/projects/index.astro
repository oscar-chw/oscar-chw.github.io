---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import IndexList from "../../components/IndexList.astro";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const groups = [...new Set(all.map((p) => p.data.group))];
let n = 1;
const blocks = groups.map((g) => { const ps = all.filter((p) => p.data.group === g); const start = n; n += ps.length; return { g, ps, start }; });
---
<Base title="Work" description="Projects by Oscar Choi: research platforms, quant research, competitions, engineering and AI.">
  <div class="wrap">
    <header class="cols top">
      <p class="comment kick">{all.length} projects</p>
      <h1>Work</h1>
      <p class="lede">Every page reads the same way: the problem, what I built, the result, how it works, and its limits. Every number comes from the linked repository or my CV.</p>
    </header>
    {blocks.map(({ g, ps, start }) => (
      <section aria-labelledby={`g-${start}`} class="grp">
        <h2 id={`g-${start}`} class="mono">{g.toLowerCase()}</h2>
        <IndexList projects={ps} start={start} />
      </section>
    ))}
  </div>
</Base>

<style>
  .top { padding-top: 64px; margin-bottom: 40px; }
  .kick { grid-column: 1 / -1; margin: 0 0 12px; }
  h1 { grid-column: 1 / -1; font-size: clamp(3rem, 1.4rem + 7vw, 8rem); letter-spacing: -0.055em; margin: 0 0 18px; }
  .lede { grid-column: 1 / span 7; color: var(--muted); font-size: 1.12rem; margin: 0; }
  .grp { margin-top: 56px; }
  .grp h2 { font-size: 0.82rem; font-weight: 400; letter-spacing: 0; color: var(--accent); margin: 0 0 12px; }
  @media (max-width: 760px) { .lede { grid-column: 1 / -1; } }
</style>
