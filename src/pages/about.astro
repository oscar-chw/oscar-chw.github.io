---
import { Picture } from "astro:assets";
import Base from "../layouts/Base.astro";
import About from "../content/pages/about.mdx";
import photo from "../assets/profile_photo.jpg";
import { SITE } from "../data/site";
---
<Base title="About" description="About Oscar Choi: education, experience, awards and skills.">
  <div class="wrap about">
    <header>
      <Picture src={photo} alt="Oscar Choi" width={176} height={176} formats={["avif", "webp"]} loading="eager" class="photo" />
      <div>
        <h1>About</h1>
        <p class="comment">{SITE.fullName} · Hong Kong · <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.instagram}>@terrific_owl</a></p>
      </div>
    </header>
    <div class="body"><About /></div>
  </div>
</Base>

<style>
  .about { padding-top: 32px; max-width: 900px; }
  header { display: flex; gap: 28px; align-items: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .photo { border-radius: 50%; width: 132px; height: 132px; object-fit: cover; border: 1px solid var(--line); }
  .comment a { color: inherit; }
  .body :global(.row) { display: grid; grid-template-columns: 190px 1fr; gap: 6px 28px; border-top: 1px solid var(--line); padding: 16px 0; }
  .body :global(.when) { font: 0.82rem/1.9 ui-monospace, Menlo, monospace; color: var(--muted); }
  .body :global(.row ul) { padding-left: 1.1rem; }
  .body :global(.row p:last-child), .body :global(.row ul:last-child) { margin-bottom: 0; }
  .body :global(.skills) { display: grid; grid-template-columns: 190px 1fr; gap: 10px 28px; margin: 0; }
  .body :global(.skills dt) { font: 0.82rem/1.9 ui-monospace, Menlo, monospace; color: var(--muted); }
  .body :global(.skills dd) { margin: 0; }
  @media (max-width: 640px) { .body :global(.row), .body :global(.skills) { grid-template-columns: 1fr; } }
</style>
