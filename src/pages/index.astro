---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Harbour from "../components/harbour/Harbour.astro";
import IndexList from "../components/IndexList.astro";
import { SITE } from "../data/site";
import { url } from "../lib/url";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
// the scroll story: each featured project's headline figure, one per screen, with a visual
// derived from the figure itself (no second source of numbers to drift out of sync)
const story = featured.filter((p) => p.data.metrics[0]);
type Viz = { kind: "ratio" | "cut" | "rank" | "count"; n: number };
const viz = (v: string): Viz => {
  const n = Number((v.match(/\d+(?:\.\d+)?/) ?? ["0"])[0]);
  if (/×/.test(v)) return { kind: "ratio", n };
  if (/^[−-]/.test(v)) return { kind: "cut", n };
  if (/top/i.test(v)) return { kind: "rank", n };
  return { kind: "count", n };
};
const building = ["quant research infrastructure", "market-data platforms", "GPU simulators", "AI tools you can check"];
const demos = [
  ["/demos/fourier/", "Fourier portrait", "500 circles redraw a line portrait. Draw your own shape."],
  ["/demos/order-book/", "Order-book replay", "A price-time-priority matching engine, step by step."],
  ["/demos/reconciliation/", "Streaming reconciliation", "Same 225,000 rows: in-memory vs streaming."],
  ["/demos/harbour/", "The harbour", "BTC history as a skyline, the live book as water."],
] as const;
---
<Base>
  <div class="boot" data-boot aria-hidden="true" hidden>
    <pre class="mono" data-boot-log></pre>
    <p class="mono skip-hint">press any key</p>
  </div>
  <div class="spotlight" data-spotlight aria-hidden="true"></div>

  <section class="hero" aria-labelledby="hero-name">
    <canvas class="sky" data-sky data-parallax="0.35" aria-hidden="true"></canvas>
    <div class="hero-text wrap cols" data-parallax="-0.18" data-fade>
      <p class="status mono"><span class="dot" aria-hidden="true"></span>open to work <span class="sep">·</span> CS @ CUHK, class of 2027 <span class="sep">·</span> HKT <time data-clock>--:--</time> <span class="sep">·</span> BTC <b data-ticker-mid>live</b></p>
      <h1 id="hero-name" aria-label="Oscar Choi"><span data-scramble data-text="Oscar Choi" aria-hidden="true">Oscar Choi</span></h1>
      <p class="line">I build <span class="typed" data-type={JSON.stringify(building)}>{building[0]}</span><span class="caret" aria-hidden="true"></span></p>
      <p class="sub">Open to quant developer, quant research, trading, software engineering, full-stack and AI engineering roles.</p>
      <div class="cta">
        <a class="btn glass" data-magnetic href="#work">See the work</a>
        <a class="btn ghost" data-magnetic href={url("/cv/")}>Download CV</a>
      </div>
    </div>
    <div class="band"><Harbour legend={false} /></div>
  </section>

  <div class="ticker" aria-label="Live figures">
    <div class="track mono">
      {[0, 1].map((dup) => (
        <span class="run" aria-hidden={dup ? "true" : undefined}>
          <span>BTC/USDT <b class="c" data-ticker-mid>live</b></span>
          {featured.filter((p) => p.data.metrics[0]).map((p) => <span>{p.data.title.toUpperCase()} <b class="c">{p.data.metrics[0].value}</b></span>)}
          <span>OPEN TO QUANT · SWE · AI ENGINEERING</span>
        </span>
      ))}
    </div>
  </div>

  <section class="manifesto wrap" data-manifesto aria-label="Principle">
    <p class="say">{"A result only counts if it couldn't have seen the future.".split(" ").map((w) => <span>{w} </span>)}</p>
    <p class="mono why">the rule behind <a href={url("/projects/point-in-time-research/")}>point-in-time research</a>, and behind the dashed towers after t = now</p>
  </section>

  <section class="story" data-story aria-label="Selected results">
    <div class="pin">
      <ol class="rail" aria-hidden="true">{story.map(() => <li data-tick></li>)}</ol>
      {story.map((p, i) => (
        <article class="step" data-step data-active={i === 0 ? "" : undefined}>
          <div class="txt">
            <p class="comment">{String(i + 1).padStart(2, "0")} / {String(story.length).padStart(2, "0")} · {p.data.title}</p>
            <p class="fig mono" data-fig={p.data.metrics[0].value}>{p.data.metrics[0].value}</p>
            <p class="cap">{p.data.metrics[0].label}</p>
            <a class="more" href={url(`/projects/${p.id}/`)}>How it works</a>
          </div>
          {(() => { const z = viz(p.data.metrics[0].value); return (
            <div class={`viz ${z.kind}`} aria-hidden="true" style={`--n:${z.n}`}>
              {z.kind === "ratio" && (<>
                <p class="lab mono">baseline</p><div class="bar"><i style="--w:calc(100% / var(--n))"></i></div>
                <p class="lab mono">this work</p><div class="bar hot"><i style="--w:100%"></i></div>
                <p class="mono axis">relative speed</p>
              </>)}
              {z.kind === "cut" && (<>
                <p class="lab mono">before</p><div class="bar"><i style="--w:100%"></i></div>
                <p class="lab mono">after</p><div class="bar hot"><i style="--w:calc(100% - var(--n) * 1%)"></i></div>
                <p class="mono axis">peak memory</p>
              </>)}
              {z.kind === "rank" && (<>
                <div class="track"><i class="field"></i><b style="--at:calc(100% - var(--n) * 1%)"></b></div>
                <p class="mono axis">all teams → the top {z.n}%</p>
              </>)}
              {z.kind === "count" && (<>
                <div class="dots">{Array.from({ length: 120 }, (_, k) => <i style={`--k:${k}`}></i>)}</div>
                <p class="mono axis">each dot ≈ 1/120 of the total</p>
              </>)}
            </div>
          ); })()}
        </article>
      ))}
    </div>
  </section>

  <section id="work" class="wrap section" aria-labelledby="work-h">
    <div class="head cols">
      <h2 id="work-h">Selected work</h2>
      <p class="mono note">{all.length} projects · hover a row</p>
    </div>
    <IndexList projects={featured} preview />
    <p class="all"><a href={url("/projects/")}>All {all.length} projects</a></p>
  </section>

  <section class="wrap section" aria-labelledby="demos-h">
    <div class="head cols">
      <h2 id="demos-h">Try it in your browser</h2>
      <p class="mono note">no server · no tracking</p>
    </div>
    <ul class="tiles">
      {demos.map(([href, t, d], i) => (
        <li class="reveal" style={`--i:${i}`}>
          <a class="tile glass" data-tilt href={url(href)}>
            <span class="num mono">0{i + 1}</span>
            <span class="tt">{t}</span>
            <span class="td">{d}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap section contact" aria-labelledby="contact-h">
    <h2 id="contact-h" class="big">Let's talk.</h2>
    <div class="cta">
      <a class="btn glass" data-magnetic href={`mailto:${SITE.email}`}>{SITE.email}</a>
      <a class="btn ghost" data-magnetic href={SITE.linkedin}>LinkedIn</a>
      <a class="btn ghost" data-magnetic href={SITE.github}>GitHub</a>
      <a class="btn ghost" data-magnetic href={SITE.instagram}>Instagram</a>
    </div>
  </section>
</Base>

<script>
  import "../components/home/home";
</script>

<style>
  .spotlight { position: fixed; inset: 0; pointer-events: none; z-index: 0; opacity: 0; transition: opacity 0.4s;
    background: radial-gradient(520px circle at var(--x, 50%) var(--y, 30%), color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%); }

  /* hero: sky and headline above, the harbour along the bottom edge of the first screen */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: clip; margin-top: -60px; }
  .sky { position: absolute; inset: 0 0 25% 0; width: 100%; height: 75%; }
  .hero-text { position: relative; padding-top: 120px; padding-bottom: 36px; }
  .hero-text > * { grid-column: 1 / span 10; }
  .status { color: var(--muted); margin: 0 0 18px; font-size: 0.82rem; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .status b { color: var(--accent); font-weight: 500; display: inline-block; min-width: 9ch; }
  .sep { color: var(--line-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--up); box-shadow: 0 0 0 0 var(--up); animation: ping 2.4s infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--up) 60%, transparent); } 70%, 100% { box-shadow: 0 0 0 8px transparent; } }

  /* boot sequence: once per visit, any key skips; never shown without JS or with reduced motion */
  .boot { position: fixed; inset: 0; z-index: 50; background: var(--bg); display: flex; flex-direction: column; justify-content: flex-start; padding-top: 32vh !important; padding: 0 max(16px, (100vw - 1240px) / 2); transition: opacity 0.5s, visibility 0.5s; }
  .boot pre { margin: 0; font-size: clamp(0.78rem, 0.7rem + 0.3vw, 0.95rem); line-height: 1.8; color: var(--muted); white-space: pre-wrap; }
  .boot :global(.ok) { color: var(--up); } .boot :global(.ac) { color: var(--accent); }
  .boot[hidden] { display: none; }   /* the class sets display:flex, which would beat the hidden attribute */
  .boot.done { opacity: 0; visibility: hidden; }
  .skip-hint { position: absolute; bottom: 28px; color: var(--muted); font-size: 0.75rem; margin: 0; }

  /* manifesto: one sentence that fills in word by word as you scroll */
  .manifesto { padding: 140px 0 60px; }
  .say { font-size: clamp(2rem, 1rem + 4.4vw, 5.2rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.04; margin: 0; max-width: 18ch; }
  /* unlit words stay readable (3:1 for large text); lighting them is emphasis, not disclosure */
  .say span { color: color-mix(in srgb, var(--ink) 50%, var(--bg)); transition: color 0.25s; }
  .say span[data-on] { color: var(--ink); }
  .why { color: var(--muted); font-size: 0.85rem; margin-top: 26px; }
  @media (prefers-reduced-motion: reduce) { .say span { color: var(--ink); } }
  h1 { font-size: clamp(3.4rem, 1.6rem + 8vw, 9rem); line-height: 0.9; letter-spacing: -0.055em; margin: 0 0 22px; }
  /* room for the longest typed phrase, so typing never reflows the hero */
  .line { font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem); letter-spacing: -0.02em; margin: 0 0 10px; min-height: 2.6em; }
  @media (min-width: 900px) { .line { min-height: 1.3em; white-space: nowrap; } }
  .typed { color: var(--accent); font-family: var(--font-mono), monospace; font-size: 0.9em; }
  .caret { display: inline-block; width: 0.5em; height: 1em; background: var(--accent); vertical-align: -0.12em; margin-left: 3px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .sub { color: var(--muted); max-width: 62ch; margin-bottom: 26px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .ghost { border: 1px solid var(--line-2); background: transparent; }
  /* the harbour rises out of the page: its sky fades into the night above it, no box */
  .band { position: relative; width: 100%; margin: 0; -webkit-mask-image: linear-gradient(transparent 0, #000 38%); mask-image: linear-gradient(transparent 0, #000 38%); }
  .band :global(.stage) { border-radius: 0; box-shadow: none; background: transparent; }

  /* ticker: a live strip between the hero and the story */
  .ticker { border-block: 1px solid var(--line-2); overflow: hidden; padding: 12px 0; background: var(--bg); position: relative; z-index: 1; }
  .track { display: flex; width: max-content; animation: tick 48s linear infinite; font-size: 0.85rem; color: var(--muted); }
  .ticker:hover .track, :global(html[data-paused]) .track { animation-play-state: paused; }
  .run { display: flex; gap: 44px; padding-right: 44px; white-space: nowrap; }
  .c { color: var(--accent); font-weight: 500; }
  @keyframes tick { to { transform: translateX(-50%); } }

  /* the story: static list by default; with JS it pins and scrubs one figure per screen */
  .story { position: relative; }
  .pin { width: min(100% - 32px, 1240px); margin: 0 auto; padding: 72px 0; }
  .step { padding: 48px 0; border-bottom: 1px solid var(--line-2); }
  .fig { font-size: clamp(3.6rem, 1rem + 11vw, 11rem); line-height: 0.95; letter-spacing: -0.06em; color: var(--ink); margin: 10px 0 14px; font-weight: 600; }
  .cap { font-size: clamp(1.05rem, 0.9rem + 0.6vw, 1.4rem); color: var(--muted); max-width: 40ch; }
  .more { font-family: var(--font-mono), monospace; font-size: 0.9rem; }
  .rail { display: none; }
  .story:global(.scrub) .pin { position: sticky; top: 0; height: 100svh; display: grid; align-items: center; padding: 0; }
  .step { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: center; }
  .txt { grid-column: 1 / span 6; }
  .viz { grid-column: 8 / -1; display: flex; flex-direction: column; gap: 16px; --l: 1; }
  .bar { position: relative; height: 34px; border-left: 1px solid var(--line-2); }
  .bar i { position: absolute; left: 0; top: 8px; bottom: 8px; width: calc(var(--w) * var(--l)); background: var(--line-2); border-radius: 0 6px 6px 0; transition: width 0.15s linear; }
  .bar.hot i { background: var(--accent); }
  .lab { font-size: 0.78rem; color: var(--muted); margin: 0 0 -10px; }
  .axis { color: var(--muted); font-size: 0.8rem; margin: 0; }
  .track { position: relative; height: 54px; }
  .track .field { position: absolute; inset: 22px 0; background: repeating-linear-gradient(90deg, var(--line-2) 0 2px, transparent 2px 7px); }
  .track b { position: absolute; top: 0; bottom: 0; left: calc(var(--at) * var(--l)); width: 3px; background: var(--accent); box-shadow: 0 0 18px var(--accent); }
  .dots { display: grid; grid-template-columns: repeat(20, 1fr); gap: 6px; }
  .dots i { aspect-ratio: 1; border-radius: 50%; background: var(--line-2); }
  .dots i { background: color-mix(in srgb, var(--accent) calc(clamp(0, (var(--l) * 120 - var(--k)) * 100, 100) * 1%), var(--line-2)); }
  .story:global(.scrub) .step { grid-area: 1 / 1; border: 0; padding: 0 0 0 56px; opacity: 0; transform: translateY(30px); transition: opacity 0.45s, transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1); pointer-events: none; }
  .story:global(.scrub) .step[data-active] { opacity: 1; transform: none; pointer-events: auto; }
  .story:global(.scrub) .rail { display: flex; flex-direction: column; gap: 10px; grid-area: 1 / 1; align-self: center; list-style: none; margin: 0; padding: 0; width: 20px; }
  .rail li { width: 2px; height: 34px; background: var(--line-2); transition: background 0.3s, height 0.3s; }
  .rail li[data-active] { background: var(--accent); height: 56px; }

  .section { position: relative; z-index: 1; padding-top: 72px; }
  .head { align-items: baseline; margin-bottom: 18px; }
  .head h2 { grid-column: 1 / span 8; margin: 0; }
  .note { grid-column: 9 / -1; text-align: right; color: var(--muted); margin: 0; }
  .all { margin-top: 18px; font-family: var(--font-mono), monospace; font-size: 0.92rem; }

  /* demos: the one place for tiles; glass, lit where the cursor is, tilting in 3D */
  .tiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 24px; }
  .tile { position: relative; display: flex; flex-direction: column; gap: 10px; height: 100%; min-height: 220px; padding: 22px; border-radius: 22px; color: var(--ink); text-decoration: none; transition: transform 0.2s ease-out; overflow: hidden; }
  .tile::after { content: ""; position: absolute; inset: 0; background: radial-gradient(280px circle at var(--mx, 50%) var(--my, 0%), color-mix(in srgb, var(--accent) 16%, transparent), transparent 60%); pointer-events: none; }
  .num { color: var(--accent); }
  .tt { font-size: 1.3rem; font-weight: 600; letter-spacing: -0.02em; margin-top: auto; }
  .td { color: var(--muted); font-size: 0.93rem; line-height: 1.5; }

  .contact { text-align: left; padding-top: 140px; }
  .big { font-size: clamp(3rem, 1rem + 9vw, 8.5rem); letter-spacing: -0.055em; margin: 0 0 30px; }

  @media (max-width: 900px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) { .txt, .viz { grid-column: 1 / -1; } .viz { margin-top: 24px; } }
  @media (max-width: 560px) {
    .tiles { grid-template-columns: 1fr; }
    .hero-text > * { grid-column: 1 / -1; }
    .head h2, .note { grid-column: 1 / -1; text-align: left; }
  }
</style>
