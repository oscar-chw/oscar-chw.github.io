---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Harbour from "../components/harbour/Harbour.astro";
import WorkObject from "../components/home/WorkObject.astro";
import Hobbies from "../components/Hobbies.astro";
import Icon from "../components/Icon.astro";
import { Picture } from "astro:assets";
import photo from "../assets/profile_photo.jpg";
import portrait from "../data/portrait-path.json";
import { EXPERIMENTS } from "../data/lab";
import { SITE } from "../data/site";
import { url } from "../lib/url";

const all = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const building = ["quant research infrastructure", "market-data platforms", "GPU simulators", "AI tools you can check"];
// the Fourier line portrait as one SVG path (pen-up samples start a new subpath)
const portraitPath = portrait.pts.map(([x, y], i) => `${i === 0 || portrait.pen[i] ? "M" : "L"}${x.toFixed(0)} ${y.toFixed(0)}`).join("");
---
<Base>
  <div class="boot" data-boot aria-hidden="true" hidden>
    <pre class="mono" data-boot-log></pre>
    <p class="mono skip-hint">press any key</p>
  </div>
  <div class="spotlight" data-spotlight aria-hidden="true"></div>

  <section class="hero" aria-labelledby="hero-name">
    <canvas class="sky" data-sky data-parallax="0.35" aria-hidden="true"></canvas>
    <div class="hero-text wrap cols" data-parallax="-0.18" data-fade>
      <figure class="me" data-cursor="hi">
        <Picture src={photo} alt="Oscar Choi" width={360} height={360} formats={["avif", "webp"]} loading="eager" class="me-photo" />
        <svg class="me-line" viewBox="0 0 800 800" aria-hidden="true"><path d={portraitPath} pathLength="1" /></svg>
        <figcaption class="mono">hover: the same face, as one line</figcaption>
      </figure>
      <p class="status mono"><span class="dot" aria-hidden="true"></span>open to work <span class="sep">·</span> CS @ CUHK, class of 2027 <span class="sep">·</span> HKT <time data-clock>--:--</time> <span class="sep">·</span> <span data-ticker-label>ETH</span> <b data-ticker-mid>live</b></p>
      <h1 id="hero-name" aria-label="Oscar Choi"><span data-scramble data-text="Oscar Choi" aria-hidden="true">Oscar Choi</span></h1>
      <p class="line">I build <span class="typed" data-type={JSON.stringify(building)}>{building[0]}</span><span class="caret" aria-hidden="true"></span></p>
      <p class="sub">Open to quant developer, quant research, trading, software engineering, full-stack and AI engineering roles.</p>
      <div class="cta">
        <a class="btn glass" data-magnetic href="#work"><Icon name="arrow-down-right" />See the work</a>
        <a class="btn ghost" data-magnetic href={url("/cv/Oscar_Choi_CV.pdf")} download><Icon name="download" />Download CV</a>
      </div>
    </div>
    <div class="band"><Harbour legend={false} /></div>
  </section>

  <div class="ticker gridded" aria-label="Live figures">
    <div class="track mono">
      {[0, 1].map((dup) => (
        <span class="run" aria-hidden={dup ? "true" : undefined}>
          <span><span data-ticker-label>ETH</span>/USDT <b class="c" data-ticker-mid>live</b></span>
          {featured.filter((p) => p.data.metrics[0]).map((p) => <span>{p.data.title.toUpperCase()} <b class="c">{p.data.metrics[0].value}</b></span>)}
          <span>OPEN TO QUANT · SWE · AI ENGINEERING</span>
        </span>
      ))}
    </div>
  </div>

  <section class="manifesto" data-manifesto aria-label="Principle"><div class="wrap">
    <p class="say">{"A result only counts if it couldn't have seen the future.".split(" ").map((w) => <span>{w} </span>)}</p>
    <p class="mono why">the rule behind <a href={url("/projects/ai-quant-research-system/") + "#point-in-time-research"}>point-in-time research</a>, and behind the dashed towers after t = now</p>
  </div></section>

  <div class="sheet gridded">
  <div class="mega" data-velocity aria-hidden="true"><div class="mega-track">{[0, 1].map(() => <span>quant research · data platforms · low-latency systems · ai engineering · </span>)}</div></div>

  <section id="work" class="wrap section" aria-labelledby="work-h">
    <div class="head cols">
      <h2 id="work-h">Selected work</h2>
      <p class="mono note">scroll or hover · the object follows</p>
    </div>
    <WorkObject projects={featured} />
    <p class="all"><a href={url("/projects/")}>All {all.length} projects</a></p>
  </section>

  <section class="wrap section labteaser" aria-labelledby="lab-h">
    <div class="head cols">
      <h2 id="lab-h">The Lab</h2>
      <p class="mono note">one experiment for every project · runs in your browser</p>
    </div>
    <div class="lt-term">
      <p class="mono lt-prompt"><span class="c">oscar@chw</span>:~/lab $ ls</p>
      <ul class="lt-ls mono">
        {EXPERIMENTS.map((x, i) => (
          <li class="reveal" style={`--i:${i % 6}`}><a href={url(x.kind === "page" ? x.href! : `/demos/#${x.id}`)} data-cursor="run"><span class="f">{x.folder}/</span><b>{x.file}</b><span class="d">{x.title}</span></a></li>
        ))}
        <li class="more"><a href={url("/demos/")}><span class="f">…/</span><b>every experiment</b><span class="d">in the Lab</span></a></li>
      </ul>
      <a class="btn glass enter" href={url("/demos/")}><Icon name="flask-conical" />Enter the lab</a>
    </div>
  </section>

  <section class="wrap section contact" aria-labelledby="contact-h">
    <h2 id="contact-h" class="big">Let's talk.</h2>
    <div class="offclock"><Hobbies /></div>
    <div class="cta">
      <a class="btn glass" data-magnetic href={`mailto:${SITE.email}`}><Icon name="mail" />{SITE.email}</a>
      <a class="btn ghost" data-magnetic href={SITE.linkedin}><Icon name="linkedin" />LinkedIn</a>
      <a class="btn ghost" data-magnetic href={SITE.github}><Icon name="github" />GitHub</a>
      <a class="btn ghost" data-magnetic href={SITE.instagram}><Icon name="instagram" />Instagram</a>
      <button type="button" class="btn ghost" data-magnetic data-copy={SITE.discord} aria-label={`Copy Discord username ${SITE.discord}`}><Icon name="discord" /><span>Discord · {SITE.discord}</span></button>
    </div>
  </section>
  </div>
</Base>

<script>
  import "../components/home/home";
</script>

<style>
  .spotlight { position: fixed; inset: 0; pointer-events: none; z-index: 5; mix-blend-mode: screen; opacity: 0; transition: opacity 0.4s;
    background: radial-gradient(520px circle at var(--x, 50%) var(--y, 30%), color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%); }

  /* hero: sky and headline above, the harbour along the bottom edge of the first screen */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; overflow: clip; margin-top: -60px; }
  .sky { position: absolute; inset: 0 0 25% 0; width: 100%; height: 75%; }
  .hero-text { position: relative; padding-top: 120px; padding-bottom: 36px; }
  .hero-text > * { grid-column: 1 / span 10; }
  .status { color: var(--muted); margin: 0 0 18px; font-size: 0.82rem; display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .status b { color: var(--accent); font-weight: 500; display: inline-block; min-width: 9ch; }
  .sep { color: var(--line-2); }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--up); box-shadow: 0 0 0 0 var(--up); animation: ping 2.4s infinite; }
  @keyframes ping { 0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--up) 60%, transparent); } 70%, 100% { box-shadow: 0 0 0 8px transparent; } }

  /* boot sequence: once per visit, any key skips; never shown without JS or with reduced motion */
  .boot { position: fixed; inset: 0; z-index: 50; background: var(--bg); display: flex; flex-direction: column; justify-content: flex-start; padding-top: 32vh !important; padding: 0 max(16px, (100vw - 1240px) / 2); transition: opacity 0.5s, visibility 0.5s; }
  .boot pre { margin: 0; font-size: clamp(0.78rem, 0.7rem + 0.3vw, 0.95rem); line-height: 1.8; color: var(--muted); white-space: pre-wrap; }
  .boot :global(.ok) { color: var(--up); } .boot :global(.ac) { color: var(--accent); }
  .boot[hidden] { display: none; }   /* the class sets display:flex, which would beat the hidden attribute */
  .boot.done { opacity: 0; visibility: hidden; }
  .skip-hint { position: absolute; bottom: 28px; color: var(--muted); font-size: 0.75rem; margin: 0; }

  /* manifesto: one sentence that fills in word by word, pinned while the work sheet slides over it */
  .manifesto { position: sticky; top: 0; min-height: 100svh; display: flex; align-items: center; z-index: 0; }
  @media (max-width: 700px) { .manifesto { position: relative; min-height: 0; padding: 72px 0 56px; } }
  .manifesto > .wrap { width: min(100% - 32px, 1240px); }
  .say { font-size: clamp(2rem, 1rem + 4.4vw, 5.2rem); font-weight: 600; letter-spacing: -0.045em; line-height: 1.04; margin: 0; max-width: 18ch; }
  /* unlit words stay readable (3:1 for large text); lighting them is emphasis, not disclosure */
  .say span { color: color-mix(in srgb, var(--ink) 50%, var(--bg)); transition: color 0.25s; }
  .say span[data-on] { color: var(--ink); }
  .why { color: var(--muted); font-size: 0.85rem; margin-top: 26px; }
  @media (prefers-reduced-motion: reduce) { .say span { color: var(--ink); } }
  h1 { font-size: clamp(3.4rem, 1.6rem + 8vw, 9rem); line-height: 0.9; letter-spacing: -0.055em; margin: 0 0 22px; }
  /* room for the longest typed phrase, so typing never reflows the hero */
  .line { font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem); letter-spacing: -0.02em; margin: 0 0 10px; min-height: 2.6em; }
  @media (min-width: 900px) { .line { min-height: 1.3em; white-space: nowrap; } }
  .typed { color: var(--accent); font-family: var(--font-mono), monospace; font-size: 0.9em; }
  .caret { display: inline-block; width: 0.5em; height: 1em; background: var(--accent); vertical-align: -0.12em; margin-left: 3px; animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .sub { color: var(--muted); max-width: 62ch; margin-bottom: 26px; }
  .cta { display: flex; flex-wrap: wrap; gap: 12px; }
  .ghost { border: 1px solid var(--line-2); background: transparent; }
  /* the harbour rises out of the page: its sky fades into the night above it, no box */
  /* the photo: a liquid-glass frame; hover and the Fourier line portrait draws itself over it */
  .hero-text { position: relative; }
  .me { position: absolute; right: 0; top: calc(50% - 150px); margin: 0; width: 300px; aspect-ratio: 1; border-radius: 50%; padding: 8px; background: var(--glass-bg); border: 1px solid var(--glass-edge); box-shadow: inset 0 1px 0 var(--glass-hi), var(--shadow); animation: float 7s ease-in-out infinite; }
  .me :global(img) { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; display: block; transition: filter 0.7s, opacity 0.7s; }
  .me-line { position: absolute; inset: 8px; width: calc(100% - 16px); height: calc(100% - 16px); border-radius: 50%; pointer-events: none; }
  .me-line path { fill: none; stroke: var(--accent); stroke-width: 2.4; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 2.6s cubic-bezier(0.65, 0, 0.35, 1); }
  .me:hover :global(img) { filter: grayscale(1) brightness(0.25); }
  .me:hover .me-line path { stroke-dashoffset: 0; }
  .me figcaption { position: absolute; left: 50%; bottom: -30px; transform: translateX(-50%); white-space: nowrap; font-size: 0.7rem; color: var(--muted); }
  @keyframes float { 50% { transform: translateY(-10px); } }
  .hero-text > :not(.me) { grid-column: 1 / span 9; }
  .band { position: relative; width: 100%; margin: 0; -webkit-mask-image: linear-gradient(transparent 0, #000 38%); mask-image: linear-gradient(transparent 0, #000 38%); }
  .band :global(.stage) { border-radius: 0; box-shadow: none; background: transparent; }

  /* ticker: a live strip between the hero and the manifesto */
  .ticker { border-block: 1px solid var(--line-2); overflow: hidden; padding: 12px 0; position: relative; z-index: 1; }
  .track { display: flex; width: max-content; animation: tick 48s linear infinite; font-size: 0.85rem; color: var(--muted); }
  .ticker:hover .track, :global(html[data-paused]) .track { animation-play-state: paused; }
  .run { display: flex; gap: 44px; padding-right: 44px; white-space: nowrap; }
  .c { color: var(--accent); font-weight: 500; }
  @keyframes tick { to { transform: translateX(-50%); } }

  /* the sheet: everything after the manifesto rises over it like a page being pulled up */
  .sheet { position: relative; z-index: 2; border-radius: 40px 40px 0 0; box-shadow: 0 -30px 80px rgb(0 0 0 / 0.55), inset 0 1px 0 var(--line-2); padding-top: 28px; margin-top: 10vh; }
  .mega { overflow: hidden; padding: 18px 0 8px; border-bottom: 1px solid var(--line); }
  .mega-track { display: flex; width: max-content; will-change: transform; }
  .mega-track span { font-size: clamp(3rem, 1.5rem + 7vw, 8.5rem); font-weight: 700; letter-spacing: -0.04em; line-height: 1; white-space: nowrap; color: transparent; -webkit-text-stroke: 1px color-mix(in srgb, var(--ink) 35%, transparent); padding-right: 0.4em; }
  .section { position: relative; z-index: 1; padding-top: 72px; }
  .head { align-items: baseline; margin-bottom: 18px; }
  .head h2 { grid-column: 1 / span 8; margin: 0; }
  .note { grid-column: 9 / -1; text-align: right; color: var(--muted); margin: 0; }
  .all { margin-top: 18px; font-family: var(--font-mono), monospace; font-size: 0.92rem; }

  /* the lab teaser: a terminal listing, each line runs its experiment */
  .lt-term { border: 1px solid var(--line-2); border-radius: 24px; padding: 22px 24px 26px; background: color-mix(in srgb, var(--bg-2) 55%, transparent); }
  .lt-prompt { margin: 0 0 14px; color: var(--muted); }
  .lt-ls { list-style: none; margin: 0 0 22px; padding: 0; columns: 2 320px; column-gap: 40px; }
  .lt-ls li { break-inside: avoid; }
  .lt-ls a { display: grid; grid-template-columns: auto auto 1fr; gap: 0 10px; align-items: baseline; padding: 7px 8px; border-radius: 10px; color: var(--ink); text-decoration: none; background-image: none !important; transition: background 0.2s, padding 0.35s cubic-bezier(0.16, 1, 0.3, 1); }
  .lt-ls a:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); padding-left: 16px; }
  .lt-ls .f { color: var(--muted); } .lt-ls b { color: var(--accent); font-weight: 500; }
  .lt-ls .d { color: var(--muted); font-size: 0.8rem; text-align: right; }
  /* narrow phones: the title drops under the file name instead of pushing the row off screen */
  /* phones: six files and a pointer to the rest, not twenty rows to scroll past */
  .lt-ls .more { display: none; }
  @media (max-width: 700px) { .lt-ls li:nth-child(n+7):not(.more) { display: none; } .lt-ls .more { display: block; } }
  @media (max-width: 520px) { .lt-ls a { grid-template-columns: auto minmax(0, 1fr); } .lt-ls b { overflow-wrap: anywhere; } .lt-ls .d { grid-column: 1 / -1; text-align: left; } }
  .offclock { color: var(--muted); margin: -10px 0 26px; font-size: 1.05rem; }

  .contact { text-align: left; padding-top: 140px; }
  .big { font-size: clamp(3rem, 1rem + 9vw, 8.5rem); letter-spacing: -0.055em; margin: 0 0 30px; }

  @media (max-width: 1100px) { .me { width: 220px; top: calc(50% - 110px); } }
  @media (max-width: 900px) { .me { position: relative; top: 0; grid-column: 1 / -1; width: 132px; margin-bottom: 18px; } .me figcaption { display: none; } .hero-text > :not(.me) { grid-column: 1 / -1; } }
  @media (max-width: 560px) {
    .hero-text > * { grid-column: 1 / -1; }
    .head h2, .note { grid-column: 1 / -1; text-align: left; }
  }
</style>
