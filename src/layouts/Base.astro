---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import Icon from "../components/Icon.astro";
import "../styles/global.css";
import { SITE } from "../data/site";
import { url } from "../lib/url";

interface Props { title?: string; description?: string; errorPage?: boolean }
const { title, description = SITE.description, errorPage = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · quant research infrastructure`;
const canonical = new URL(Astro.url.pathname, SITE.site).href;
const nav = [
  ["Work", "/projects/", "layers"],
  ["Demos", "/demos/", "sparkles"],
  ["About", "/about/", "user"],
  ["CV", "/cv/", "file-text"],
] as const;
const here = Astro.url.pathname;
// command palette entries: every page, every project, every demo, plus a few actions
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
const commands: [string, string, string][] = [
  ["home", "Home", url("/")],
  ["work", "All projects", url("/projects/")],
  ...projects.map((p) => ["project", p.data.title, url(`/projects/${p.id}/`)] as [string, string, string]),
  ["demo", "Fourier portrait", url("/demos/fourier/")],
  ["demo", "Order-book replay", url("/demos/order-book/")],
  ["demo", "Streaming reconciliation", url("/demos/reconciliation/")],
  ["demo", "The harbour", url("/demos/harbour/")],
  ["page", "About", url("/about/")],
  ["page", "CV (PDF download)", url("/cv/Oscar_Choi_CV.pdf")],
  ["page", "Contact card", url("/card/")],
  ["link", "Email Oscar", `mailto:${SITE.email}`],
  ["link", "GitHub", SITE.github],
  ["link", "LinkedIn", SITE.linkedin],
  ["link", "Instagram @terrific_owl", SITE.instagram],
];
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {!errorPage && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url("/og.png"), SITE.site).href} />
    <meta name="theme-color" content="#05070c" />
    {(errorPage || import.meta.env.BASE_URL !== "/") && <meta name="robots" content="noindex" />}
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={url("/sitemap-index.xml")} />
    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />
    <script is:inline data-inline="theme">
      // Before first paint, so a light-theme reader never sees a dark flash.
      try { const t = localStorage.getItem("theme"); if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; } catch {}
      // true liquid glass (backdrop refraction through an SVG filter) renders only in Chromium; others keep frosted glass
      if (navigator.userAgentData) document.documentElement.classList.add("lg");
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="liquid" x="0" y="0" width="100%" height="100%" color-interpolation-filters="sRGB">
        <feImage href="data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A//www.w3.org/2000/svg%22%20width%3D%22100%22%20height%3D%22100%22%20preserveAspectRatio%3D%22none%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22x%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23000%22/%3E%3Cstop%20offset%3D%22.18%22%20stop-color%3D%22%23800000%22/%3E%3Cstop%20offset%3D%22.82%22%20stop-color%3D%22%23800000%22/%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23f00%22/%3E%3C/linearGradient%3E%3ClinearGradient%20id%3D%22y%22%20x2%3D%220%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%23000%22/%3E%3Cstop%20offset%3D%22.3%22%20stop-color%3D%22%23008000%22/%3E%3Cstop%20offset%3D%22.7%22%20stop-color%3D%22%23008000%22/%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%230f0%22/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect%20width%3D%22100%22%20height%3D%22100%22%20fill%3D%22url%28%23x%29%22/%3E%3Crect%20width%3D%22100%22%20height%3D%22100%22%20fill%3D%22url%28%23y%29%22%20style%3D%22mix-blend-mode%3Ascreen%22/%3E%3C/svg%3E" x="0" y="0" width="100%" height="100%" preserveAspectRatio="none" result="map" />
        <feDisplacementMap in="SourceGraphic" in2="map" scale="-34" xChannelSelector="R" yChannelSelector="G" result="bent" />
        <feGaussianBlur in="bent" stdDeviation="0.6" />
      </filter>
    </svg>
    <header class="site-header">
      <div class="bar glass">
        <a class="brand" href={url("/")}><span>oscar@chw</span><span class="sr-only"> home</span></a>
        <label class="term"><span class="tilde mono" aria-hidden="true">:~$</span><input class="cmd mono" data-term type="text" placeholder="type help" aria-label="Type a command or search the site" autocomplete="off" spellcheck="false" /></label>
        <nav aria-label="Primary">
          <ul>
            {nav.map(([label, path, icon]) => (
              <li><a href={url(path)} aria-current={here.startsWith(url(path)) ? "page" : undefined}><Icon name={icon} size={16} /><span class="lbl">{label}</span></a></li>
            ))}
          </ul>
        </nav>
        <button class="kbtn" type="button" data-palette-open aria-label="Search the site" title="Search (⌘K or /)"><Icon name="search" size={15} /><kbd class="mono">⌘K</kbd></button>
        <button class="theme" type="button" aria-label="Switch colour theme" title="Switch colour theme">
          <Icon name="moon" size={16} class="i-dark" /><Icon name="sun" size={16} class="i-light" />
        </button>
      </div>
    </header>
    <dialog class="palette glass" aria-label="Command palette" data-cv={url("/cv/Oscar_Choi_CV.pdf")} data-mail={SITE.email} data-js={url("/console.js")}>
      <form method="dialog" class="pf">
        <span class="mono prompt" aria-hidden="true">~$</span>
        <input type="text" class="pq mono" placeholder="search, or a command (help)" aria-label="Search pages or run a command" autocomplete="off" spellcheck="false" />
        <kbd class="mono esc">esc</kbd>
      </form>
      <pre class="po mono" aria-live="polite" hidden></pre>
      <ul class="pl" role="listbox" aria-label="Results">
        {commands.map(([kind, label, href]) => (
          <li role="option"><a href={href}><span class="mono k">{kind}</span><span>{label}</span></a></li>
        ))}
      </ul>
    </dialog>
    <main id="content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer wrap cols">
      <p class="comment">built with Astro · static · no tracking</p>
      <ul>
        <li><a href={`mailto:${SITE.email}`}><Icon name="mail" size={15} />{SITE.email}</a></li>
        <li><a href={SITE.github} aria-label="GitHub" title="GitHub"><Icon name="github" size={17} /></a></li>
        <li><a href={SITE.linkedin} aria-label="LinkedIn" title="LinkedIn"><Icon name="linkedin" size={17} /></a></li>
        <li><a href={SITE.instagram} aria-label="Instagram" title="Instagram"><Icon name="instagram" size={17} /></a></li>
        <li><a href={url("/card/")}><Icon name="qr-code" size={15} />Contact card</a></li>
      </ul>
    </footer>
    <script is:inline data-inline="palette">
      // Opens the console; its code (console.js) loads only on first use.
      (() => {
        const d = document.querySelector(".palette"), bar = document.querySelector("[data-term]");
        let m, handing = false;
        const load = () => (m ||= import(d.dataset.js));
        const open = (t = "") => load().then((c) => c.open(t));
        document.querySelectorAll("[data-palette-open]").forEach((b) => b.addEventListener("click", () => open()));
        // keep typing in the bar while the console loads, then hand over everything typed so far
        const hand = () => { if (handing) return; handing = true; load().then((c) => { const t = bar.value; bar.value = ""; handing = false; c.open(t); }); };
        if (bar) { bar.addEventListener("input", hand); bar.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); hand(); } }); }
        addEventListener("keydown", (e) => {
          const t = e.target, typing = t instanceof HTMLElement && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
          if ((e.key === "k" && (e.metaKey || e.ctrlKey)) || (e.key === "/" && !typing)) { e.preventDefault(); open(); }
        });
      })();
    </script>
    <script>
      import "../components/motion/motion";
    </script>
    <script is:inline data-inline="theme">
      document.querySelector(".theme").addEventListener("click", () => {
        const r = document.documentElement, next = r.dataset.theme === "light" ? "dark" : "light";
        r.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
        document.dispatchEvent(new CustomEvent("themechange"));
      });
    </script>
  </body>
</html>

<style>
  /* a floating glass command bar: the one piece of chrome that hovers over the page */
  .site-header { position: sticky; top: 12px; z-index: 20; display: flex; justify-content: center; padding: 12px 16px 0; }
  .bar { display: flex; align-items: center; gap: 22px; padding: 7px 8px 7px 18px; border-radius: 999px; width: min(100%, 760px); }
  .brand { color: var(--ink); text-decoration: none; font: 500 0.92rem var(--font-mono), monospace; white-space: nowrap; padding: 6px 0; }   /* a 24px+ tap target */
  /* the prompt is a real input: typing here opens the console with what was typed */
  .term { display: flex; align-items: center; gap: 6px; margin-right: auto; min-width: 0; flex: 1; cursor: text; }
  .tilde { color: var(--accent); font-size: 0.92rem; }
  .cmd { flex: 1; min-width: 0; width: 100%; background: none; border: 0; outline: 0; color: var(--ink); font-size: 0.86rem; caret-color: var(--accent); }
  .cmd::placeholder { color: color-mix(in srgb, var(--muted) 70%, transparent); }
  .po { margin: 0; padding: 12px 20px; border-bottom: 1px solid var(--glass-edge); color: var(--accent); font-size: 0.82rem; white-space: pre-wrap; }
  nav ul, .site-footer ul { list-style: none; display: flex; gap: 4px; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a { display: flex; align-items: center; gap: 7px; color: var(--muted); text-decoration: none; font-size: 0.92rem; padding: 6px 12px; border-radius: 999px; }
  nav a:hover { color: var(--ink); }
  nav a[aria-current="page"] { color: var(--ink); background: var(--glass-bg); box-shadow: inset 0 0 0 1px var(--glass-edge); }
  .kbtn { display: inline-flex; align-items: center; gap: 6px; background: none; border: 1px solid var(--glass-edge); color: var(--muted); border-radius: 999px; height: 34px; padding: 0 11px; cursor: pointer; flex: none; }
  .kbtn kbd { font-size: 0.72rem; }
  :global(html[data-theme="light"]) .theme :global(.i-dark), :global(html:not([data-theme="light"])) .theme :global(.i-light) { display: none; }
  .site-footer a { display: inline-flex; align-items: center; gap: 7px; }
  .kbtn:hover { color: var(--ink); border-color: var(--accent); }
  .palette { width: min(100% - 32px, 620px); margin: 14vh auto auto; padding: 0; border-radius: 22px; color: var(--ink); overflow: hidden; }
  .palette::backdrop { background: rgb(0 0 0 / 0.5); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .pf { display: flex; align-items: center; gap: 10px; padding: 14px 18px; border-bottom: 1px solid var(--glass-edge); }
  .prompt { color: var(--accent); }
  .pq { flex: 1; background: none; border: 0; outline: 0; color: var(--ink); font-size: 1rem; }
  .esc { font-size: 0.7rem; color: var(--muted); border: 1px solid var(--glass-edge); border-radius: 6px; padding: 1px 6px; }
  .pl { list-style: none; margin: 0; padding: 8px; max-height: 52vh; overflow: auto; }
  .pl a { display: flex; gap: 14px; align-items: baseline; padding: 9px 12px; border-radius: 12px; color: var(--ink); text-decoration: none; }
  .pl li[aria-selected] a, .pl a:hover { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .k { width: 56px; flex: none; font-size: 0.72rem; color: var(--muted); }
  .theme { background: none; border: 1px solid var(--glass-edge); color: var(--muted); border-radius: 50%; width: 34px; height: 34px; display: grid; place-items: center; cursor: pointer; flex: none; }
  .theme:hover { color: var(--ink); }
  main { outline: none; }
  .site-footer { border-top: 1px solid var(--line-2); margin-top: 120px; padding-block: 28px 44px; align-items: baseline; row-gap: 12px; }
  .site-footer p { margin: 0; grid-column: 1 / span 5; }
  .site-footer ul { grid-column: 6 / -1; justify-content: flex-end; gap: 22px; }
  .site-footer a { color: var(--muted); font-size: 0.9rem; }
  @media (max-width: 640px) {
    .bar { gap: 6px; padding-left: 14px; }
    .term, .kbtn kbd { display: none; }
    .brand { margin-right: auto; }
    .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    nav a { padding: 8px 9px; }
    .bar { gap: 2px; }
    .site-footer p, .site-footer ul { grid-column: 1 / -1; justify-content: flex-start; }
  }
  @media print { .site-header, .site-footer, .skip { display: none; } }
</style>
