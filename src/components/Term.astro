---
// A technical term with a plain-English definition that pops up on hover or keyboard focus.
// Pure CSS: works on text pages with no JavaScript, and the definition is linked for screen readers.
import { GLOSSARY } from "../data/glossary";
interface Props { t: keyof typeof GLOSSARY }
const { t } = Astro.props;
const id = `def-${t.replace(/[^a-z0-9]+/gi, "-").toLowerCase()}-${Math.random().toString(36).slice(2, 7)}`;
---
<span class="def" tabindex="0" aria-describedby={id}><slot /><span class="pop glass" role="tooltip" id={id}><b class="mono">{t}</b>{GLOSSARY[t]}</span></span>

<style>
  .def { position: relative; text-decoration: underline dotted color-mix(in srgb, var(--accent) 70%, transparent); text-underline-offset: 0.22em; text-decoration-thickness: 1.5px; cursor: help; border-radius: 3px; }
  .def:hover, .def:focus-visible { color: var(--accent); }
  .def .pop { position: absolute; left: 50%; bottom: calc(100% + 12px); z-index: 30; width: max-content; max-width: min(300px, 78vw); padding: 12px 14px; border-radius: 16px; font-size: 0.86rem; line-height: 1.5; font-weight: 400; color: var(--ink); text-align: left; pointer-events: none; background-color: color-mix(in srgb, var(--bg-2) 94%, transparent);
    opacity: 0; visibility: hidden; transform: translate(-50%, 8px) scale(0.96); transform-origin: 50% 100%; transition: opacity 0.2s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s 0.2s; }
  .def .pop b { display: block; color: var(--accent); font-size: 0.72rem; font-weight: 500; margin-bottom: 4px; }
  .def:hover .pop, .def:focus-visible .pop { opacity: 1; visibility: visible; transform: translate(-50%, 0) scale(1); transition: opacity 0.2s, transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), visibility 0s; }
</style>
