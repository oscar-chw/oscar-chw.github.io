---
// A pipeline diagram as an ordered list: numbered stages on a connector line, each with a short
// note. Plain HTML, so it stays legible at any width and reads naturally to screen readers.
interface Step { label: string; note?: string; accent?: "accent" | "amber" | "up" | "down" }
interface Props { steps: Step[]; title: string; caption?: string }
const { steps, title, caption } = Astro.props;
---
<figure class="flow">
  <ol aria-label={title}>
    {steps.map((s, i) => (
      <li class={s.accent ? `hl ${s.accent}` : undefined}>
        <span class="i mono">{String(i + 1).padStart(2, "0")}</span>
        <span class="l">{s.label}</span>
        {s.note && <span class="n mono">{s.note}</span>}
      </li>
    ))}
  </ol>
  {caption && <figcaption class="comment">{caption}</figcaption>}
</figure>

<style>
  .flow { margin: 1.6rem 0 2.2rem; }
  ol { list-style: none; margin: 0; padding: 0; position: relative; }
  ol::before { content: ""; position: absolute; left: 15px; top: 18px; bottom: 18px; width: 1px; background: var(--line-2); }
  li { position: relative; display: grid; grid-template-columns: 32px minmax(0, 1fr) auto; column-gap: 16px; align-items: baseline; padding: 11px 0; }
  li + li { border-top: 1px dashed var(--line); }
  .i { position: relative; z-index: 1; width: 32px; text-align: center; font-size: 0.72rem; color: var(--muted); background: var(--bg); padding: 2px 0; border: 1px solid var(--line-2); border-radius: 999px; }
  .l { font-weight: 600; color: var(--ink); }
  .n { color: var(--muted); font-size: 0.8rem; text-align: right; }
  .hl .i { color: var(--bg); border-color: transparent; }
  .accent .i { background: var(--accent); } .amber .i { background: var(--amber); }
  .up .i { background: var(--up); } .down .i { background: var(--down); }
  figcaption { margin-top: 0.7rem; }
  @media (max-width: 560px) { li { grid-template-columns: 32px minmax(0, 1fr); } .n { grid-column: 2; text-align: left; } }
</style>
