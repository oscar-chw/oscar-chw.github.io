---
// The interactive harbour. Canvas painted client-side; the visible legend below it
// is real text, so the picture is never the only way to read the data.
import { REGIMES } from "../../lib/market";
interface Props { legend?: boolean; picker?: boolean }
const { legend = true, picker = false } = Astro.props;
---
<figure class="harbour">
  <div class="stage" data-testid="harbour" tabindex="0" role="group" data-base={import.meta.env.BASE_URL} data-book="ETH"
       aria-label="Victoria Harbour drawn from a simulated market. Use the left and right arrow keys to read each part; Escape hides the read-out."
       aria-describedby={legend ? "harbour-legend" : undefined}>
    <canvas width="1584" height="396" aria-hidden="true"></canvas>
    <svg class="life" aria-hidden="true"></svg>
    <div class="xh" aria-hidden="true" hidden></div><div class="xv" aria-hidden="true" hidden></div>
    <span class="xp mono" aria-hidden="true" hidden></span><span class="xd mono" aria-hidden="true" hidden></span>
    <div class="tip" data-testid="harbour-tip" aria-live="polite" hidden></div>
    <div class="book">
      <span class="badge mono" data-testid="book-badge" role="status">starting…</span>
      <button type="button" class="pause mono" data-testid="book-pause" aria-pressed="false" aria-label="Pause the simulated market">Pause</button>
    </div>
  </div>
  {picker && (
    <form class="market mono" data-market aria-label="Choose the market">
      <fieldset>
        <legend>market</legend>
        <label><input type="radio" name="regime" value="switching" checked /> Regime-switching</label>
        {Object.entries(REGIMES).map(([k, r]) => <label title={r.blurb}><input type="radio" name="regime" value={k} /> {r.label}</label>)}
      </fieldset>
      <label class="seed">seed <input type="number" name="seed" value="42" min="1" max="999999" inputmode="numeric" /></label>
      <fieldset>
        <legend>water</legend>
        <label title="live from Binance"><input type="radio" name="book" value="ETH" checked /> ETH/USDT live</label>
        <label title="live from Binance"><input type="radio" name="book" value="BTC" /> BTC/USDT live</label>
        <label title="live from Binance"><input type="radio" name="book" value="SOL" /> SOL/USDT live</label>
        <label title="the simulated market's own book"><input type="radio" name="book" value="sim" /> Simulated</label>
      </fieldset>
    </form>
  )}
  {legend && (
    <figcaption id="harbour-legend">
      <ul>
        <li><span class="k">buildings</span> one per 30 sessions of a market simulated by my matching engine; roof = close on a log scale, spire light = high</li>
        <li><span class="k">windows</span> one per session: <span class="up">green up</span>, <span class="down">red down</span></li>
        <li><span class="k">beams</span> the QTS data platform's race test: 12 readers, 5 writers, 0 commits lost</li>
        <li><span class="k">t = now</span> nothing to its right is used: no look-ahead</li>
        <li><span class="k">water</span> a live order book, ETH/USDT from Binance's public feed (<span class="up">bids</span> | <span class="down">asks</span>); if the feed is unavailable, the simulated market keeps trading and its own book takes over</li>
      </ul>
    </figcaption>
  )}
</figure>

<script>
  import { mountHarbour } from "./harbour";
  for (const el of document.querySelectorAll<HTMLElement>("[data-testid=harbour]")) void mountHarbour(el);
</script>

<style>
  .harbour { margin: 0; }
  .stage { position: relative; border-radius: 10px; overflow: hidden; box-shadow: var(--shadow); background: #0a1022; cursor: crosshair; aspect-ratio: 4 / 1; }
  canvas { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 100% 50%; }
  .book { position: absolute; left: 10px; bottom: 10px; display: flex; gap: 6px; z-index: 1; }   /* above the WebGL water */
  .badge { min-width: 15ch; text-align: center; }
  .badge, .pause { padding: 3px 9px; border-radius: 99px; background: rgb(8 13 26 / 0.8); color: #c9dbe4; border: 1px solid #2b3d5c; font-size: 0.75rem; }
  .pause { cursor: pointer; font-family: ui-monospace, Menlo, monospace; }
  .pause:hover { border-color: #6ee6d7; }
  .badge[data-state="live"] { color: #3fb950; border-color: #2d6a3a; }
  .stage :global(.ripples) { position: absolute; left: 0; width: 100%; pointer-events: none; z-index: 0; }
  /* living layer: same coordinates as the canvas, same cover crop */
  .life { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
  .life :global(.roofline) { fill: none; stroke: #aaf0e6; stroke-width: 1.4; stroke-dasharray: var(--len); stroke-dashoffset: var(--len); filter: drop-shadow(0 0 4px #6ee6d7); animation: draw 3.6s cubic-bezier(0.4, 0, 0.2, 1) 0.4s forwards; }
  .life :global(.pkt) { fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-dasharray: 10 calc(var(--len) * 1px + 40px); animation: flow linear infinite; }
  .life :global(.pkt.r) { stroke: #6ee6d7; } .life :global(.pkt.w) { stroke: #ffbe78; stroke-width: 2.2; }
  .life :global(.win) { fill: #0e182e; opacity: 0; animation: flick ease-in-out infinite; }
  .life :global(.ping) { fill: none; stroke: #c8f0ff; transform-box: fill-box; transform-origin: center; animation: ping 2.4s ease-out infinite; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes flow { from { stroke-dashoffset: 10; } to { stroke-dashoffset: calc(var(--len) * -1px - 10px); } }
  @keyframes flick { 0%, 88%, 100% { opacity: 0; } 92%, 96% { opacity: 0.95; } }
  @keyframes ping { 0% { transform: scale(1); opacity: 0.85; } 100% { transform: scale(5); opacity: 0; } }
  :global(html[data-paused]) .life :global(*) { animation-play-state: paused; }
  /* easter egg: "lights" in the console, or the Konami code, starts a Symphony of Lights */
  :global(html.lights) .life :global(.pkt) { animation-duration: 0.7s !important; stroke-width: 3; filter: drop-shadow(0 0 6px currentColor); }
  :global(html.lights) .life :global(.pkt.r) { color: #6ee6d7; } :global(html.lights) .life :global(.pkt.w) { color: #ffbe78; }
  :global(html.lights) .life :global(.roofline) { animation: draw 0s forwards, glow 1.2s ease-in-out infinite alternate; }
  :global(html.lights) .life :global(.win) { animation-duration: 1.4s !important; fill: #ffe9b0; }
  @keyframes glow { from { stroke: #aaf0e6; } to { stroke: #ffbe78; } }
  @media (prefers-reduced-motion: reduce) { .life :global(.roofline) { stroke-dashoffset: 0; } .life :global(.pkt), .life :global(.win), .life :global(.ping) { display: none; } }
  .xh, .xv { position: absolute; pointer-events: none; z-index: 1; }
  .xh { left: 0; right: 0; top: 0; height: 0; border-top: 1px dashed rgb(110 230 215 / 0.55); }
  .xv { top: 0; bottom: 0; left: 0; width: 0; border-left: 1px dashed rgb(110 230 215 / 0.55); }
  .xp, .xd { position: absolute; z-index: 1; pointer-events: none; font-size: 11px; padding: 1px 6px; background: #6ee6d7; color: #05070c; border-radius: 3px; }
  .xp { right: 6px; top: -9px; }
  .xd { bottom: 6px; left: -40px; }
  .stage:has(.xh:not([hidden])) { cursor: none; }
  .tip { position: absolute; max-width: min(340px, calc(100% - 12px)); max-height: calc(100% - 8px); overflow: auto; background: rgb(8 13 26 / 0.95); border: 1px solid #2b3d5c; border-radius: 8px; padding: 8px 10px; font: 13px/1.45 ui-monospace, Menlo, monospace; color: #d6e6ee; z-index: 2; }
  .tip :global(a) { color: #6ee6d7; }
  .tip :global(.g) { color: #3fb950; } .tip :global(.r) { color: #ff7b72; }
  figcaption ul { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 6px 28px; color: var(--muted); font-size: 0.88rem; }
  .k { font-family: ui-monospace, Menlo, monospace; color: var(--ink); margin-right: 6px; }
  .market { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 18px; margin-top: 14px; font-size: 0.8rem; }
  .market fieldset { display: flex; flex-wrap: wrap; gap: 6px; border: 0; padding: 0; margin: 0; }
  .market legend { float: left; color: var(--muted); margin-right: 6px; padding: 5px 0; }
  .market fieldset label { display: inline-flex; align-items: center; padding: 5px 12px; border: 1px solid var(--line-2); border-radius: 99px; cursor: pointer; transition: border-color 0.2s, background 0.2s; }
  .market fieldset label:hover { border-color: var(--accent); }
  .market fieldset input { position: absolute; opacity: 0; pointer-events: none; }
  .market fieldset label:has(input:checked) { background: var(--accent); border-color: var(--accent); color: var(--bg); }
  .market fieldset label:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .market .seed { color: var(--muted); display: inline-flex; align-items: center; gap: 8px; }
  .market .seed input { width: 9ch; font: inherit; color: var(--ink); background: transparent; border: 1px solid var(--line-2); border-radius: 6px; padding: 4px 8px; }
  @media (max-width: 700px) { .stage { aspect-ratio: 2 / 1; } }
</style>
