---
// Projects as one aligned list: number, title, stack, headline figure, on the 12-column grid.
// The title morphs into the project page's heading through a shared view-transition name.
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/url";

interface Props { projects: CollectionEntry<"projects">[]; start?: number }
const { projects, start = 1 } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---
<div class="index">
  <ol>
    {projects.map((p, i) => (
      <li class="reveal" style={`--i:${i % 4}`}>
        <a href={url(`/projects/${p.id}/`)}>
          <span class="n mono">{pad(start + i)}</span>
          <span class="t" style={`view-transition-name: p-${p.id}`}>{p.data.title}</span>
          <span class="s mono">{p.data.stack.slice(0, 2).join(" · ").toLowerCase()}</span>
          <span class="f mono">{p.data.metrics[0]?.value ?? ""}</span>
        </a>
      </li>
    ))}
  </ol>
</div>

<style>
  .index { position: relative; }
  ol { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line-2); }
  li { border-top: 1px solid var(--line-2); }
  a {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; align-items: baseline;
    padding: 22px 0; color: var(--ink); text-decoration: none; position: relative;
    transition: padding 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), color 0.2s;
  }
  a::before { content: ""; position: absolute; inset: 0; background: var(--accent); opacity: 0; transition: opacity 0.25s; z-index: -1; }
  a:hover, a:focus-visible { padding-left: 14px; }
  a:hover::before, a:focus-visible::before { opacity: 0.06; }
  .n { grid-column: span 1; color: var(--muted); }
  .t { grid-column: span 6; font-size: clamp(1.25rem, 0.9rem + 1.4vw, 2rem); font-weight: 600; letter-spacing: -0.02em; line-height: 1.15; }
  .s { grid-column: span 3; color: var(--muted); }
  .f { grid-column: span 2; color: var(--accent); text-align: right; font-size: 0.95rem; }
  @media (max-width: 760px) {
    .n { grid-column: span 2; } .t { grid-column: span 10; }
    .s { grid-column: 3 / span 6; } .f { grid-column: span 4; }
  }
</style>
